// Inline Try surfaces for slint-math-input. No additional native window is created.
import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ToolButton } from "controls.slint";
import { MathCaptionFont } from "@math_caption_font";

export struct MathInputView {
    image: image, content-width: float, content-height: float,
    caret-x: float, caret-y: float, caret-height: float,
    font-size: float, accessible-text: string,
    can-undo: bool, can-redo: bool, has-content: bool,
}
export struct MathKey { label: string, token: string, hint: string, image: image }

// Each host component has its own state; the App owns the active editing session.
export global MathInputState {
    in-out property <bool> open;
    in-out property <bool> practice;
    in-out property <bool> keypad-expanded;
    in-out property <MathInputView> formula;
    in-out property <string> error;
    in-out property <bool> complete;
    in-out property <[string]> categories;
    in-out property <[MathKey]> catalog;
    in-out property <[MathKey]> common-keys;
    in-out property <int> category;
    in-out property <int> focus-request;
    in-out property <float> keypad-left;
    in-out property <float> keypad-top;
    in-out property <float> keypad-width;
    in-out property <float> apply-center-x;
    in-out property <float> apply-center-y;
    in-out property <float> cancel-center-x;
    in-out property <float> cancel-center-y;
    callback committed(string);
    callback key(string, bool, bool, bool) -> bool;
    callback seek(float, float, bool);
    callback keypad(string, bool);
    callback choose-category(int);
    callback apply();
    callback dismiss();
    callback refresh-view();
    callback reveal(float, float);
    in-out property <float> pad-bottom;
}

export component StructuredMathSurface inherits Rectangle {
    in property <MathInputView> view: MathInputState.formula;
    in property <bool> structured: true;
    in property <bool> enabled: true;
    in property <string> plain-input;
    in property <int> plain-anchor;
    in property <int> plain-caret;
    in property <int> plain-revision;
    callback plain-edited(string);
    callback plain-position-changed(string, int, int);
    callback plain-command(string);
    private property <bool> restoring;
    changed plain-input => {
        if !root.structured {
            root.restoring = true;
            input.text = root.plain-input;
            root.restoring = false;
        }
    }
    changed plain-revision => { root.restore-plain(); }
    changed structured => {
        if root.structured { input.text = ""; }
        else { root.restore-plain(); }
    }
    function restore-plain() {
        if !root.structured {
            root.restoring = true;
            input.text = root.plain-input;
            input.set-selection-offsets(root.plain-anchor, root.plain-caret);
            root.restoring = false;
        }
    }
    in property <bool> framed: true;
    in property <int> focus-request: MathInputState.focus-request;
    changed focus-request => { input.focus(); }
    init => { root.restore-plain(); if root.structured { input.focus(); } }
    committed(text) => { MathInputState.committed(text); }
    command(text, control, shift, alt) => { return MathInputState.key(text, control, shift, alt); }
    seek(x, y, extend) => { MathInputState.seek(x, y, extend); }
    submitted => { MathInputState.apply(); }
    callback committed(string);
    callback command(string, bool, bool, bool) -> bool;
    callback seek(float, float, bool);
    callback submitted();
    forward-focus: input;
    out property <bool> has-focus: input.has-focus;
    out property <length> canvas-left: root.absolute-position.x + 12px - root.scroll-x * 1px;
    out property <length> canvas-top: root.absolute-position.y + root.image-y;
    out property <float> canvas-scale: 1;
    private property <bool> cursor-visible: true;
    private property <length> plain-scroll;
    private property <float> scroll-x: root.structured ? max(0, view.caret-x - (self.width / 1px - 42)) : 0;
    private property <float> scroll-y: root.structured ? max(0, view.caret-y + view.caret-height - (self.height / 1px - 24)) : 0;
    private property <length> image-y: max(0px, (self.height - view.content-height * 1px) / 2) - scroll-y * 1px;
    background: root.framed ? Theme.soft : transparent; border-radius: 7px;
    border-width: root.framed ? 1px : 0px; border-color: input.has-focus ? Theme.focus : Theme.border;
    clip: true;
    changed view => { cursor-visible = true; }
    Image {
        visible: root.structured;
        x: 12px - root.scroll-x * 1px; y: root.image-y;
        width: root.view.content-width * 1px; height: root.view.content-height * 1px;
        source: root.view.image; image-fit: contain;
    }
    if root.structured && input.has-focus && root.cursor-visible : Rectangle {
        x: 12px + (root.view.caret-x - root.scroll-x) * 1px;
        y: root.image-y + root.view.caret-y * 1px;
        width: 1.5px; height: root.view.caret-height * 1px; background: Theme.ink;
    }
    input := TextInput {
        x: root.structured ? 12px + (root.view.caret-x - root.scroll-x) * 1px : 12px + root.plain-scroll;
        y: root.structured ? root.image-y + root.view.caret-y * 1px : 0px;
        width: root.structured ? max(16px, root.width - self.x - 12px) : root.width - 24px;
        height: root.structured ? max(22px, root.view.caret-height * 1px) : root.height;
        enabled: root.enabled;
        color: Theme.ink; font-size: root.structured ? root.view.font-size * 1px : 22px;
        vertical-alignment: center;
        horizontal-alignment: root.structured ? left : center;
        text-cursor-width: root.structured ? 0px : 1px; single-line: true;
        accessible-label: root.structured ? @tr("公式输入") + ": " + root.view.accessible-text : @tr("你的答案");
        edited => {
            if root.structured {
                if self.text != "" { root.committed(self.text); self.text = ""; }
            } else {
                root.plain-edited(self.text);
                if !root.structured && !root.restoring { root.plain-position-changed(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset); }
            }
        }
        cursor-position-changed(position) => {
            if !root.structured {
                if !root.restoring { root.plain-position-changed(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset); }
                if position.x + root.plain-scroll < 0px { root.plain-scroll = -position.x; }
                else if position.x + root.plain-scroll > self.width - 1px { root.plain-scroll = self.width - position.x - 1px; }
                if root.plain-scroll > 0px { root.plain-scroll = 0px; }
            }
        }
        key-pressed(event) => {
            root.cursor-visible = true;
            if event.text == Key.Return { root.submitted(); return accept; }
            if root.structured {
                if event.text == Key.Escape { MathInputState.dismiss(); return accept; }
                if root.command(event.text, event.modifiers.control || event.modifiers.meta, event.modifiers.shift, event.modifiers.alt) {
                    return accept;
                }
            } else if !event.modifiers.alt && (event.modifiers.control || event.modifiers.meta) {
                if event.text == "z" || event.text == "Z" { root.plain-command(event.modifiers.shift ? "redo" : "undo"); return accept; }
                if event.text == "y" || event.text == "Y" { root.plain-command("redo"); return accept; }
            }
            return reject;
        }
    }
    TouchArea {
        enabled: root.structured && root.enabled;
        mouse-cursor: text;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.seek((self.mouse-x - 12px) / 1px + root.scroll-x, (self.mouse-y - root.image-y) / 1px, event.modifiers.shift);
                input.focus(); root.cursor-visible = true;
            }
        }
        moved => { if self.pressed { root.seek((self.mouse-x - 12px) / 1px + root.scroll-x, (self.mouse-y - root.image-y) / 1px, true); } }
    }
    Timer { interval: 500ms; running: input.has-focus; triggered => { root.cursor-visible = !root.cursor-visible; } }
}

export component StructuredMathPad inherits Rectangle {
    out property <length> natural-height: layout.preferred-height;
    height: self.natural-height;
    vertical-stretch: 0;
    private property <bool> symbols-page;
    private property <int> active-category: MathInputState.category;
    private property <[MathKey]> displayed-keys: root.symbols-page ? MathInputState.catalog : MathInputState.common-keys;
    changed active-category => { keys.content-y = 0px; }
    changed symbols-page => { keys.content-y = 0px; }
    private property <length> keys-left: keys.absolute-position.x;
    private property <length> keys-top: keys.absolute-position.y;
    private property <length> keys-width: keys.visible-width;
    private property <length> pad-bottom: root.absolute-position.y + root.height;
    changed pad-bottom => { root.measure(); }
    changed keys-left => { root.measure(); }
    changed keys-top => { root.measure(); }
    changed keys-width => { root.measure(); }
    init => { root.measure(); }
    function measure() {
        MathInputState.pad-bottom = root.pad-bottom / 1px;
        MathInputState.keypad-left = root.keys-left / 1px;
        MathInputState.keypad-top = root.keys-top / 1px;
        MathInputState.keypad-width = root.keys-width / 1px;
    }
    function refocus() { MathInputState.focus-request += 1; }
    function press(token: string) {
        MathInputState.keypad(token, false);
        root.refocus();
    }
    layout := VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            height: 32px; spacing: 6px;
            ToolButton { label: @tr("结构"); name: self.label; font-size: 14px; checkable: true; checked: !root.symbols-page; activated => { root.symbols-page = false; root.refocus(); } }
            ToolButton { label: @tr("符号"); name: self.label; font-size: 14px; checkable: true; checked: root.symbols-page; activated => { root.symbols-page = true; root.refocus(); } }
        }
        if root.symbols-page : ComboBox {
            height: 32px;
            model: MathInputState.categories; current-index: MathInputState.category;
            selected(value) => { MathInputState.choose-category(self.current-index); root.refocus(); }
        }
        keys := ScrollView {
            height: root.symbols-page ? 160px : 120px; vertical-stretch: 0;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            private property <int> count: root.displayed-keys.length;
            private property <int> columns: root.symbols-page && self.visible-width < 360px ? 3 : 4;
            private property <length> row-pitch: 40px;
            content-height: ceil(self.count / self.columns) * self.row-pitch;
            for index in self.count : Rectangle {
                x: mod(index, parent.columns) * (parent.content-width / parent.columns);
                y: floor(index / parent.columns) * parent.row-pitch;
                width: parent.content-width / parent.columns - 4px; height: parent.row-pitch - 4px;
                private property <string> label: root.displayed-keys[index].label;
                private property <string> token: root.displayed-keys[index].token;
                private property <string> hint: root.displayed-keys[index].hint;
                private property <image> preview: root.displayed-keys[index].image;
                background: key-touch.has-hover ? Theme.hover : Theme.soft;
                border-radius: 5px; border-width: 1px; border-color: key-focus.has-focus ? Theme.focus : Theme.border;
                accessible-role: button; accessible-label: self.hint;
                accessible-action-default => { root.press(self.token); }
                forward-focus: key-focus;
                Text { visible: parent.preview.width == 0; x: 4px; width: parent.width - 8px; height: parent.height; text: parent.label; color: Theme.ink; font-size: 14px; font-family: MathCaptionFont.family; wrap: word-wrap; overflow: elide; horizontal-alignment: center; vertical-alignment: center; }
                Image { visible: parent.preview.width > 0; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: min(parent.width - 12px, parent.preview.width * 0.5px); height: min(parent.height - 6px, parent.preview.height * 0.5px); source: parent.preview; image-fit: contain; colorize: Theme.ink; }
                Tooltip { text: @markdown("\{parent.hint}"); }
                key-focus := FocusScope {
                    key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.press(parent.token); return accept; } return reject; }
                }
                key-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.press(parent.token); }
                }
            }
        }
        HorizontalLayout {
            height: 28px; spacing: 4px;
            ToolButton { height: 28px; glyph: @image-url("../assets/backspace.svg"); icon-only: true; name: @tr("退格"); activated => { root.press("key:backspace"); } }
            ToolButton { height: 28px; glyph: @image-url("../assets/undo.svg"); icon-only: true; name: @tr("撤销"); enabled: MathInputState.formula.can-undo; activated => { root.press("key:undo"); } }
            ToolButton { height: 28px; glyph: @image-url("../assets/redo.svg"); icon-only: true; name: @tr("重做"); enabled: MathInputState.formula.can-redo; activated => { root.press("key:redo"); } }
            ToolButton { height: 28px; label: @tr("清空"); name: @tr("清空此输入框"); font-size: 14px; destructive: true; enabled: MathInputState.formula.has-content; activated => { root.press("key:clear"); } }
        }
        if MathInputState.error != "" : Text { text: MathInputState.error; color: Theme.wrong-ink; font-size: 12px; wrap: word-wrap; }
        if !MathInputState.practice : HorizontalLayout {
            height: 32px; spacing: 8px;
            ToolButton { label: @tr("取消"); name: self.label; font-size: 14px; border-width: 1px; border-color: Theme.border;
                private property <length> center-x: self.absolute-position.x + self.width / 2;
                private property <length> center-y: self.absolute-position.y + self.height / 2;
                changed center-x => { MathInputState.cancel-center-x = self.center-x / 1px; }
                changed center-y => { MathInputState.cancel-center-y = self.center-y / 1px; }
                activated => { MathInputState.dismiss(); }
            }
            ToolButton { label: @tr("应用公式"); name: self.label; font-size: 14px; border-width: 1px; border-color: Theme.ink;
                private property <length> center-x: self.absolute-position.x + self.width / 2;
                private property <length> center-y: self.absolute-position.y + self.height / 2;
                changed center-x => { MathInputState.apply-center-x = self.center-x / 1px; }
                changed center-y => { MathInputState.apply-center-y = self.center-y / 1px; }
                activated => { MathInputState.apply(); }
            }
        }
    }
}

export component StructuredMathPane inherits Rectangle {
    height: layout.preferred-height;
    // Reveal once after expansion; subsequent manual scrolling stays untouched.
    Timer {
        interval: 1ms; running: true;
        triggered => { MathInputState.reveal(root.absolute-position.y / 1px, root.height / 1px); self.running = false; }
    }
    layout := VerticalLayout {
        spacing: 10px;
        StructuredMathSurface {
            height: max(64px, min(128px, MathInputState.formula.content-height * 1px + 24px)); vertical-stretch: 0;
        }
        StructuredMathPad { }
    }
}
