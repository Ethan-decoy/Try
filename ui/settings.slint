import { DesktopButton, SelectionMenu } from "desktop_controls.slint";
import { Theme } from "theme.slint";
import { LineEdit, ScrollView, SpinBox } from "std-widgets.slint";
import { IconButton, SettingsCheck } from "controls.slint";

component TimeSetting inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <string> detail;
    in property <bool> paused;
    in property <int> value;
    in property <int> maximum: 1440;
    in property <string> unit: @tr("分钟");
    in property <[string]> options;
    in property <int> selection;
    private property <int> draft;
    out property <string> display-value: time-menu.display-value;
    callback choose(int);
    callback apply-value(int);
    callback resume();
    height: 48px;
    public function show-details() { root.draft = root.value; details.show(); }
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; spacing: 10px;
        Rectangle {
            horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; height: 48px;
            Text { width: parent.width; y: root.paused ? 7px : 0px; height: root.paused ? 20px : 48px; text: root.label; color: Theme.ink; font-size: 13px; vertical-alignment: center; }
            if root.paused : HorizontalLayout {
                y: 28px; width: parent.width; height: 20px; spacing: 6px;
                Text { text: root.detail; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                Rectangle {
                    width: 50px; height: 20px;
                    accessible-role: button; accessible-label: @tr("恢复");
                    accessible-action-default => { root.resume(); }
                    forward-focus: resume-focus;
                    Text { text: @tr("恢复"); color: Theme.ink; font-size: 11px; vertical-alignment: center; }
                    resume-focus := FocusScope { width: 0px; key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.resume(); return accept; } return reject; } }
                    if resume-focus.has-focus : Rectangle { y: parent.height - 1px; width: 18px; height: 1px; background: Theme.focus; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.resume(); } }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }
        Rectangle {
            width: 164px; height: 48px;
            time-menu := SelectionMenu {
                y: (parent.height - self.height) / 2;
                options: root.options; selection: root.selection;
                label: root.label;
                choose(index) => { root.choose(index); }
            }
        }
        Rectangle {
            width: 36px; height: 48px;
            IconButton {
                y: (parent.height - self.height) / 2;
                glyph: @image-url("../assets/adjustments.svg");
                label: @tr("精细配置") + root.label; borderless: true;
                ink: Theme.muted;
                activated => { root.show-details(); }
            }
        }
    }
    if root.hint != "" : Tooltip { text: @markdown("\{root.hint}"); }
    details := PopupWindow {
        x: max(0px, root.width - self.width - 14px);
        y: root.height + 6px;
        width: 272px;
        height: root.hint == "" ? 124px : 160px;
        close-policy: close-on-click-outside;
        forward-focus: precise-input;
        Rectangle {
            background: Theme.soft; border-radius: 12px;
            border-width: 1px; border-color: Theme.border;
            FocusScope {
                capture-key-pressed(event) => {
                    if event.text == Key.Escape { details.close(); return accept; }
                    if event.text == Key.Return { root.apply-value(root.draft); details.close(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 14px; spacing: 8px;
                    HorizontalLayout {
                        Text { text: root.label; color: Theme.ink; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        IconButton { glyph: @image-url("../assets/cross_mark.svg"); label: @tr("收起精细配置"); borderless: true; activated => { details.close(); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        precise-input := SpinBox { minimum: 1; maximum: root.maximum; value <=> root.draft; height: 36px; accessible-label: @tr("精细时间"); }
                        Text { text: root.unit; color: Theme.muted; vertical-alignment: center; }
                        IconButton { glyph: @image-url("../assets/check_mark.svg"); label: @tr("应用时间"); borderless: true; activated => { root.apply-value(root.draft); details.close(); } }
                    }
                    if root.hint != "" : Text { text: root.hint; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <int> interval-minutes;
    in property <[string]> interval-options;
    in property <int> interval-selection;
    in property <int> feedback-seconds;
    in property <[string]> feedback-options;
    in property <int> feedback-selection;
    in property <int> knowledge-seconds;
    in property <[string]> knowledge-options;
    in property <int> knowledge-selection;
    in property <int> pause-minutes;
    in property <[string]> pause-options;
    in property <int> pause-selection;
    in property <string> pause-detail;
    in property <bool> autostart-enabled;
    in property <bool> autostart-available;
    in property <string> autostart-error;
    in property <bool> quiet-hours-enabled;
    in-out property <string> quiet-start;
    in-out property <string> quiet-end;
    in property <string> quiet-summary;
    in property <string> quiet-time-error;
    in property <int> popup-corner;
    in property <bool> remember-position;
    in property <bool> show-pack-tags;
    in property <bool> focus-on-reminder;
    in property <bool> auto-check-updates;
    in property <int> interface-language;
    in property <int> appearance;
    out property <string> interval-display: interval-setting.display-value;
    out property <string> feedback-display: feedback-setting.display-value;
    out property <string> knowledge-display: knowledge-setting.display-value;
    out property <string> pause-display: pause-setting.display-value;
    out property <length> content-top: settings-scroll.absolute-position.y;
    out property <length> language-left: language-menu.absolute-position.x;
    out property <length> language-top: language-menu.absolute-position.y;
    out property <length> appearance-left: appearance-menu.absolute-position.x;
    out property <length> appearance-top: appearance-menu.absolute-position.y;
    out property <length> reminder-focus-left: reminder-focus-check.absolute-position.x;
    out property <length> reminder-focus-top: reminder-focus-check.absolute-position.y;
    out property <length> automatic-update-left: automatic-update-check.absolute-position.x;
    out property <length> automatic-update-top: automatic-update-check.absolute-position.y;
    callback choose-interval(int);
    callback choose-feedback(int);
    callback choose-knowledge-duration(int);
    callback choose-pause(int);
    callback set-interval(int);
    callback set-feedback(int);
    callback set-knowledge-duration(int);
    callback set-pause(int);
    callback set-autostart(bool);
    callback set-quiet-enabled(bool);
    callback set-quiet-range(string, string);
    callback set-corner(int);
    callback set-remember-position(bool);
    callback set-show-pack-tags(bool);
    callback set-focus-on-reminder(bool);
    callback set-auto-check-updates(bool);
    callback choose-language(int);
    callback choose-appearance(int);
    in-out property <int> section: 0;
    public function show-pause-details() { root.section = 0; pause-setting.show-details(); }
    background: transparent;
    VerticalLayout {
        spacing: 16px;
        HorizontalLayout {
            height: 32px; spacing: 4px;
            for title[index] in [@tr("练习"), @tr("卡片"), @tr("通用")] : DesktopButton {
                text: title; selected: root.section == index;
                activated => { root.section = index; }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        settings-scroll := ScrollView {
            horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
            VerticalLayout {
                spacing: 0px; alignment: start;
                Rectangle {
                    visible: root.section == 0; height: self.visible ? 188px : 0px;
                    interval-setting := TimeSetting { y: 0px; width: parent.width; label: @tr("出题间隔"); value: root.interval-minutes; options: root.interval-options; selection: root.interval-selection; choose(index) => { root.choose-interval(index); } apply-value(value) => { root.set-interval(value); } }
                    feedback-setting := TimeSetting { y: 48px; width: parent.width; label: @tr("答对后停留"); value: root.feedback-seconds; options: root.feedback-options; selection: root.feedback-selection; maximum: 60; unit: @tr("秒"); hint: @tr("答对后开始计时，随后自动收起"); choose(index) => { root.choose-feedback(index); } apply-value(value) => { root.set-feedback(value); } }
                    knowledge-setting := TimeSetting { y: 96px; width: parent.width; label: @tr("知识展示停留"); value: root.knowledge-seconds; options: root.knowledge-options; selection: root.knowledge-selection; maximum: 60; unit: @tr("秒"); hint: @tr("展示答案后开始计时，随后自动收起"); choose(index) => { root.choose-knowledge-duration(index); } apply-value(value) => { root.set-knowledge-duration(value); } }
                    Text { x: 14px; y: 152px; width: parent.width - 28px; text: @tr("答错后按 Enter 确认，不自动收起"); color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                }
                Rectangle { visible: root.section == 0; height: self.visible ? 1px : 0px; background: Theme.soft-border; }
                Rectangle {
                    visible: root.section == 0; height: self.visible ? 48px : 0px;
                    pause-setting := TimeSetting { width: parent.width; label: @tr("暂停"); value: root.pause-minutes > 0 ? root.pause-minutes : 180; options: root.pause-options; selection: root.pause-selection; paused: root.pause-minutes != 0; detail: root.pause-detail; choose(index) => { root.choose-pause(index); } apply-value(value) => { root.set-pause(value); } resume => { root.set-pause(0); } }
                }
                Rectangle {
                    visible: root.section == 0;
                    height: self.visible ? (root.quiet-hours-enabled ? 100px : 48px) + (root.quiet-time-error != "" ? 32px : 0px) : 0px;
                    SettingsCheck { x: 14px; y: 6px; width: parent.width - 28px; text: @tr("每日免打扰"); checked: root.quiet-hours-enabled; checkbox-right: true; toggled(enabled) => { root.set-quiet-enabled(enabled); } }
                    if root.quiet-hours-enabled : HorizontalLayout {
                        x: 14px; y: 52px; width: parent.width - 28px; height: 36px; spacing: 10px;
                        LineEdit { text <=> root.quiet-start; accessible-label: @tr("免打扰开始时间"); edited(value) => { root.set-quiet-range(root.quiet-start, root.quiet-end); } }
                        Text { text: "—"; color: Theme.muted; vertical-alignment: center; }
                        LineEdit { text <=> root.quiet-end; accessible-label: @tr("免打扰结束时间"); edited(value) => { root.set-quiet-range(root.quiet-start, root.quiet-end); } }
                    }
                    if root.quiet-time-error != "" : Text { x: 14px; y: parent.height - 30px; width: parent.width - 28px; text: root.quiet-time-error; color: Theme.wrong-ink; font-size: 11px; wrap: word-wrap; }
                }
                Rectangle {
                    visible: root.section == 1; height: self.visible ? 48px : 0px;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { text: @tr("卡片位置"); color: Theme.ink; font-size: 13px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle { width: 164px; height: 48px; SelectionMenu { y: 6px; options: [@tr("右下角"), @tr("左下角"), @tr("右上角"), @tr("左上角")]; selection: root.popup-corner; label: @tr("卡片初始位置"); choose(index) => { root.set-corner(index); } } }
                    }
                }
                Rectangle {
                    visible: root.section == 1; height: self.visible ? 48px : 0px;
                    SettingsCheck { x: 14px; y: 6px; width: parent.width - 28px; text: @tr("记住位置"); hint: @tr("记住拖动后的卡片位置"); checked: root.remember-position; checkbox-right: true; toggled(enabled) => { root.set-remember-position(enabled); } }
                }
                Rectangle {
                    visible: root.section == 1; height: self.visible ? 48px : 0px;
                    SettingsCheck { x: 14px; y: 6px; width: parent.width - 28px; text: @tr("显示知识包标签"); hint: @tr("标签随卡片位置自动换边"); checked: root.show-pack-tags; checkbox-right: true; toggled(enabled) => { root.set-show-pack-tags(enabled); } }
                }
                Rectangle { visible: root.section == 1; height: self.visible ? 1px : 0px; background: Theme.soft-border; }
                Rectangle {
                    visible: root.section == 1; height: self.visible ? 80px : 0px;
                    reminder-focus-check := SettingsCheck { x: 14px; y: 6px; width: parent.width - 28px; text: @tr("弹出时自动聚焦"); checkbox-right: true; checked: root.focus-on-reminder; toggled(enabled) => { root.set-focus-on-reminder(enabled); } }
                    Text { x: 14px; y: 46px; width: parent.width - 28px; text: @tr("关闭后不切换当前窗口，点击题板再作答"); color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                }
                Rectangle {
                    visible: root.section == 2; height: self.visible ? 48px : 0px;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { text: @tr("外观"); color: Theme.ink; font-size: 13px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle { width: 164px; height: 48px; appearance-menu := SelectionMenu { y: 6px; options: [@tr("浅色"), @tr("深色"), @tr("跟随系统")]; selection: root.appearance; label: @tr("外观"); choose(index) => { root.choose-appearance(index); } } }
                    }
                }
                Rectangle {
                    visible: root.section == 2; height: self.visible ? 48px : 0px;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { text: @tr("语言"); color: Theme.ink; font-size: 13px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle { width: 164px; height: 48px; language-menu := SelectionMenu { y: 6px; options: [@tr("跟随系统"), "简体中文", "English"]; selection: root.interface-language; label: @tr("语言"); choose(index) => { root.choose-language(index); } } }
                    }
                }
                Rectangle { visible: root.section == 2; height: self.visible ? 1px : 0px; background: Theme.soft-border; }
                Rectangle {
                    visible: root.section == 2; height: self.visible ? 72px : 0px;
                    automatic-update-check := SettingsCheck { x: 14px; y: 6px; width: parent.width - 28px; text: @tr("自动检查更新"); checkbox-right: true; checked: root.auto-check-updates; toggled(enabled) => { root.set-auto-check-updates(enabled); } }
                    Text { x: 14px; y: 46px; width: parent.width - 28px; text: @tr("每天最多自动检查一次"); color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                }
                Rectangle {
                    visible: root.section == 2; height: self.visible ? (root.autostart-error == "" ? 72px : 104px) : 0px;
                    SettingsCheck { x: 14px; y: 6px; width: parent.width - 28px; text: @tr("开机自启"); checked: root.autostart-enabled; enabled: root.autostart-available; checkbox-right: true; toggled(enabled) => { root.set-autostart(enabled); } }
                    Text { x: 14px; y: 46px; width: parent.width - 28px; text: @tr("登录后直接进入托盘"); color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                    if root.autostart-error != "" : Text { x: 14px; y: 72px; width: parent.width - 28px; text: root.autostart-error; color: Theme.wrong-ink; font-size: 11px; wrap: word-wrap; }
                }
            }
        }
    }
}
