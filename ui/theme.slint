// Shared desktop colors. Each window owns its palette; formula images use the
// same ink through colorize, so switching appearance needs no rasterization.
export global Theme {
    in-out property <bool> dark: true;
    out property <color> chrome: self.dark ? #25262a : #f5f5f6;
    out property <color> selected: self.dark ? #3b4657 : #dde5ef;
    out property <color> soft-border: self.dark ? #32343a : #ececef;
    out property <color> canvas: self.dark ? #202124 : #ffffff;
    out property <color> sidebar: self.dark ? #292a2e : #eeeeef;
    out property <color> panel: self.dark ? #202124 : #ffffff;
    out property <color> soft: self.dark ? #292b2f : #f7f7f8;
    out property <color> hover: self.dark ? #32343a : #f0f1f3;
    out property <color> border: self.dark ? #414348 : #dedfe3;
    out property <color> control-border: self.dark ? #777b85 : #a2a6af;
    out property <color> ink: self.dark ? #ededf0 : #24262b;
    out property <color> muted: self.dark ? #b0b2ba : #6b6e77;
    out property <color> disabled: self.dark ? #727680 : #a3a6ad;
    out property <color> primary: self.dark ? #b7ccec : #3467ac;
    out property <color> primary-ink: self.dark ? #202b3b : #ffffff;
    out property <color> focus: self.dark ? #a9c5ee : #3467ac;
    out property <color> selection: self.dark ? #a9c5ee40 : #3467ac30;
    // IBM Red 50/60 distinguish destructive actions from practice feedback.
    out property <color> danger-ink: self.dark ? #fa4d56 : #da1e28;
    out property <color> danger: #da1e28;
    out property <color> danger-hover: #b81921;
    out property <color> danger-pressed: #750e13;
    out property <color> danger-soft: self.dark ? #3e1b1e : #fff1f1;
    out property <color> on-danger: #ffffff;
    out property <color> caution-ink: self.dark ? #f1c21b : #8e6a00;
    out property <color> caution: #f1c21b;
    out property <color> caution-hover: #d2a106;
    out property <color> caution-soft: self.dark ? #332b0f : #fff8e1;
    out property <color> on-caution: #261a00;
    out property <color> scrim: #00000066;
    out property <color> correct: self.dark ? #27382f : #eff8f2;
    out property <color> correct-soft: self.dark ? #2b4235 : #e4f3e9;
    out property <color> correct-ink: self.dark ? #9dd3b4 : #2d714b;
    out property <color> wrong: self.dark ? #3b292d : #fff3f3;
    out property <color> wrong-soft: self.dark ? #4a3036 : #fde7e9;
    out property <color> wrong-ink: self.dark ? #f1afb2 : #b34247;
}
