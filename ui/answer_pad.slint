import { Theme } from "theme.slint";
import { AnswerOption, FormulaLabel, FormulaNavigation, MathRegion, NavigationTools, StructureTools, ToolButton } from "content.slint";

export component AnswerPad inherits Rectangle {
    in property <AnswerOption> preview;
    in property <[MathRegion]> regions;
    in property <MathRegion> selection;
    in property <FormulaNavigation> navigation;
    in property <string> error;
    in property <bool> can-move-out;
    in property <bool> can-unwrap;
    in property <bool> can-undo;
    in property <bool> can-redo;
    callback select-region(int);
    callback command(string);
    preferred-height: pad-layout.preferred-height;
    background: Theme.soft;
    border-radius: 6px;
    private property <[string]> labels: ["a/b", "√", "x²", "π", "↗", "⌫", "7", "8", "9", "÷", "(", ")", "4", "5", "6", "×", "−", ".", "1", "2", "3", "+", "0", "✓"];
    private property <[string]> commands: ["fraction", "root", "power", "pi", "exit", "backspace", "7", "8", "9", "/", "(", ")", "4", "5", "6", "*", "-", ".", "1", "2", "3", "+", "0", "submit"];
    private property <[string]> names: [@tr("分数"), @tr("根号"), @tr("上标"), @tr("圆周率"), @tr("在结构后继续输入"), @tr("退格"), "7", "8", "9", @tr("除号"), @tr("左括号"), @tr("右括号"), "4", "5", "6", @tr("乘号"), @tr("减号"), @tr("小数点"), "1", "2", "3", @tr("加号"), "0", @tr("提交答案")];
    pad-layout := VerticalLayout {
        padding: 8px; spacing: 8px;
        Rectangle {
            height: max(54px, min(96px, root.preview.formula-height * 1px + 16px));
            background: Theme.panel; border-radius: 4px;
            border-width: root.error != "" ? 1px : 0px;
            border-color: Theme.wrong-ink;
            picture := FormulaLabel {
                x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
                fallback: root.preview.label; formula: root.preview.formula;
                formula-width: root.preview.formula-width; formula-height: root.preview.formula-height;
                texts: root.preview.texts; font-size: 20px;
            }
            Rectangle {
                visible: root.selection.width > 0;
                x: picture.x + picture.formula-x + (root.selection.x - 3) * picture.formula-scale * 1px;
                y: picture.y + picture.formula-y + (root.selection.y - 3) * picture.formula-scale * 1px;
                width: (root.selection.width + 6) * picture.formula-scale * 1px;
                height: (root.selection.height + 6) * picture.formula-scale * 1px;
                border-width: 1px; border-color: Theme.control-border; border-radius: 3px;
                background: transparent;
            }
            for region[index] in root.regions : TouchArea {
                x: picture.x + picture.formula-x + (region.x - 3) * picture.formula-scale * 1px;
                y: picture.y + picture.formula-y + (region.y - 3) * picture.formula-scale * 1px;
                width: (region.width + 6) * picture.formula-scale * 1px;
                height: (region.height + 6) * picture.formula-scale * 1px;
                mouse-cursor: text;
                clicked => { root.select-region(index); }
            }
            if root.error != "" : Tooltip { text: @markdown("\{root.error}"); }
        }
        VerticalLayout {
            spacing: 4px;
            for row in [0,1,2,3] : HorizontalLayout {
                spacing: 4px;
                for col in [0,1,2,3,4,5] : ToolButton {
                    label: root.labels[row * 6 + col]; name: root.names[row * 6 + col];
                    icon-only: col == 5 && (row == 0 || row == 3);
                    glyph: row == 0 ? @image-url("../assets/backspace.svg") : @image-url("../assets/check_mark.svg");
                    enabled: root.commands[row * 6 + col] != "exit" || root.navigation.exit;
                    activated => { root.command(root.commands[row * 6 + col]); }
                }
            }
        }
        NavigationTools {
            navigation: root.navigation;
            show-exit: false;
            command(value) => { root.command(value); }
        }
        StructureTools {
            can-move-out: root.can-move-out;
            can-unwrap: root.can-unwrap;
            can-undo: root.can-undo;
            can-redo: root.can-redo;
            show-history: true;
            command(value) => { root.command(value); }
        }
    }
}
