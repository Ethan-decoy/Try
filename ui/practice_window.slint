import { Theme } from "theme.slint";
import { Palette, ScrollView } from "std-widgets.slint";
import { AnswerOption, FormulaLabel, NativeText, ToolButton, QuestionPicture, FormulaPosition } from "content.slint";
import { MathInputState, StructuredMathSurface, StructuredMathPad } from "structured_math.slint";

component AnswerTile inherits Rectangle {
    in property <AnswerOption> option;
    in property <bool> symbol-only;
    in property <image> symbol;
    in property <bool> enabled: true;
    in property <int> feedback: 0;
    callback activated();
    forward-focus: tile-focus;
    min-width: 0px;
    horizontal-stretch: 1;
    border-radius: 7px;
    border-width: root.feedback == 0 ? 1px : 2px;
    border-color: root.feedback == 1 ? Theme.correct-ink : root.feedback == 2 ? Theme.wrong-ink : tile-focus.has-focus ? Theme.focus : Theme.control-border;
    background: root.feedback == 1 ? Theme.correct-soft : root.feedback == 2 ? Theme.wrong-soft : tile-touch.has-hover && root.enabled ? Theme.hover : Theme.soft;
    accessible-role: button;
    accessible-label: root.option.label;
    accessible-enabled: root.enabled;
    Image {
        visible: root.symbol-only;
        source: root.symbol;
        width: 24px; height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: root.feedback == 1 ? Theme.correct-ink : root.feedback == 2 ? Theme.wrong-ink : Theme.ink;
    }
    FormulaLabel {
        visible: !root.symbol-only;
        x: 8px; y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        fallback: root.option.label;
        formula: root.option.formula;
        formula-width: root.option.formula-width;
        formula-height: root.option.formula-height;
        texts: root.option.texts;
        font-size: 20px;
        ink: root.feedback == 1 ? Theme.correct-ink : root.feedback == 2 ? Theme.wrong-ink : Theme.ink;
    }
    tile-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.activated(); return accept;
            }
            return reject;
        }
    }
    tile-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { tile-focus.focus(); root.activated(); }
    }
}

export component PracticeWindow inherits Window {
    in property <bool> dark-theme: true;
    in property <image> app-icon;
    icon: root.app-icon;
    title: @tr("Try · 练习");
    no-frame: true;
    always-on-top: true;
    width: 320px;
    in property <string> pack-tag;
    in property <bool> show-pack-tags: true;
    in property <bool> tag-on-right;
    out property <bool> pack-tag-visible: root.show-pack-tags && root.pack-tag != "";
    private property <length> tag-space: root.pack-tag-visible ? 26px : 0px;
    out property <length> pack-tag-left: tag-badge.x;
    out property <length> pack-tag-width: tag-badge.width;
    private property <length> picture-height: root.question-image-width > 0 ? min(220px, (root.width - 48px) * root.question-image-height / root.question-image-width) : 0px;
    private property <length> practice-content-height: (root.has-prompt ? max(48px, practice-prompt.preferred-height) : 0px) + root.picture-height + (root.has-prompt && root.question-image-width > 0 ? 14px : 0px) + 20px + root.answer-row-height + root.answer-footer-height;
    private property <length> knowledge-content-height: (root.has-prompt ? max(48px, knowledge-prompt.preferred-height) + 32px : 0px) + root.picture-height + (root.has-prompt && root.question-image-width > 0 ? 16px : 0px) + (root.standard-answer != "" ? 24px + max(32px, standard-label.preferred-height) : 0px);
    private property <length> answer-footer-height: MathInputState.open ? (MathInputState.keypad-expanded ? root.structured-pad-height + 13px : max(64px, structured-error.preferred-height + 26px)) : root.feedback == 2 ? max(64px, standard-label.preferred-height + 39px) : 64px;
    private property <length> desired-height: min(560px, max(230px, root.knowledge-only ? root.knowledge-content-height + 64px : root.practice-content-height + 42px) + root.tag-space);
    height: root.desired-height;
    // Native resize events assign height. Retain the content-derived target
    // separately so a taller formula updates the window after expansion.
    changed desired-height => { root.height = root.desired-height; }
    default-font-size: 18px;
    background: root.feedback == 1 ? Theme.correct : root.feedback == 2 ? Theme.wrong : Theme.panel;

    in property <string> prompt;
    in property <bool> has-prompt: true;
    in property <string> standard-answer;
    in property <image> question-image;
    in property <float> question-image-width;
    in property <float> question-image-height;
    callback preview-question-image();
    in property <image> prompt-formula;
    in property <float> prompt-formula-width;
    in property <float> prompt-formula-height;
    in property <[NativeText]> prompt-texts;
    out property <length> prompt-natural-height: !root.has-prompt ? 0px : root.knowledge-only ? knowledge-prompt.preferred-height : practice-prompt.preferred-height;
    out property <length> prompt-area-height: root.knowledge-only ? knowledge-prompt.height : practice-prompt.height;
    out property <length> answer-natural-height: standard-label.preferred-height;
    out property <length> answer-area-height: standard-label.height;
    out property <length> content-height: root.knowledge-only ? knowledge-scroll.content-height : practice-scroll.content-height;
    out property <length> visible-content-height: root.knowledge-only ? knowledge-scroll.visible-height : practice-scroll.visible-height;
    out property <length> content-scroll-y: root.knowledge-only ? knowledge-scroll.content-y : practice-scroll.content-y;
    in property <image> answer-formula;
    in property <float> answer-formula-width;
    in property <float> answer-formula-height;
    in property <[NativeText]> answer-texts;
    out property <float> pixel-scale: 1px / 1phx;
    in property <int> feedback: 0;
    in property <int> answer-mode: 0;
    in property <bool> knowledge-only;
    in property <[AnswerOption]> options;
    in property <float> option-formula-height;
    in property <int> selected-option: -1;
    private property <length> answer-row-height: MathInputState.open ? max(64px, min(112px, MathInputState.formula.content-height * 1px + 20px)) : root.answer-mode == 0 ? max(48px, min(144px, root.input-preview.formula-height * 1px + 20px)) : max(48px, root.option-formula-height * 1px + 16px);
    in-out property <string> answer-text;
    in property <AnswerOption> input-preview;
    in property <FormulaPosition> answer-position;
    out property <bool> input-math-mode: MathInputState.open;
    out property <length> input-canvas-left: answer-input.canvas-left;
    out property <length> input-canvas-top: answer-input.canvas-top;
    out property <float> input-canvas-scale: answer-input.canvas-scale;
    out property <length> formula-button-center-x: formula-toggle.absolute-position.x + formula-toggle.width / 2;
    out property <length> formula-button-center-y: formula-toggle.absolute-position.y + formula-toggle.height / 2;
    in property <string> input-error;
    out property <length> answer-footer-top: answer-footer.absolute-position.y;
    out property <length> answer-footer-left: answer-footer.absolute-position.x;
    out property <length> answer-footer-width: answer-footer.width;
    private property <length> structured-pad-height: 290px;
    callback answer-edited(string);
    callback answer-position-changed(string, int, int);
    callback input-command(string);
    callback open-structured-entry();
    callback submit-answer(string);
    callback choose-answer(int);
    callback dismiss();
    callback rasterize-formulas(float);
    changed pixel-scale => { root.rasterize-formulas(root.pixel-scale); MathInputState.refresh-view(); }

    public function focus-answer() {
        if MathInputState.open { MathInputState.focus-request += 1; }
        else if root.answer-mode == 0 && !root.knowledge-only && root.feedback == 0 { answer-input.focus(); }
        else { card-focus.focus(); }
    }
    init => { Theme.dark = root.dark-theme; Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    changed dark-theme => { Theme.dark = root.dark-theme; Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    tag-measure := Text { visible: false; text: root.pack-tag; font-size: 11px; }
    card-focus := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape && MathInputState.open { MathInputState.dismiss(); return accept; }
            if event.text == Key.Escape && root.feedback == 2 { return accept; }
            if event.text == Key.Escape || ((root.feedback != 0 || root.knowledge-only) && event.text == Key.Return) {
                root.dismiss(); return accept;
            }
            if !root.knowledge-only && root.answer-mode != 0 && root.feedback == 0 {
                if event.text == "1" { root.choose-answer(0); return accept; }
                if event.text == "2" { root.choose-answer(1); return accept; }
                if root.answer-mode == 1 && event.text == "3" { root.choose-answer(2); return accept; }
            }
            return reject;
        }
        WindowMoveArea { }
        tag-badge := Rectangle {
            visible: root.pack-tag-visible;
            x: root.tag-on-right ? root.width - self.width - 24px : 24px;
            y: 16px; width: min(138px, tag-measure.preferred-width + 18px); height: 21px;
            border-radius: 5px; border-width: 1px;
            background: root.feedback == 1 ? Theme.correct-soft : root.feedback == 2 ? Theme.wrong-soft : Theme.soft;
            border-color: root.feedback == 1 ? Theme.correct-soft : root.feedback == 2 ? Theme.wrong-soft : Theme.border;
            Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.pack-tag; color: root.feedback == 1 ? Theme.correct-ink : root.feedback == 2 ? Theme.wrong-ink : Theme.muted; font-size: 11px; overflow: elide; vertical-alignment: center; }
            Tooltip { text: @markdown("\{root.pack-tag}"); }
        }
        knowledge-scroll := ScrollView {
            visible: root.knowledge-only;
            x: 24px; y: 24px + root.tag-space;
            width: parent.width - 36px; height: parent.height - 64px - root.tag-space;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            content-height: max(self.visible-height, root.knowledge-content-height);
            VerticalLayout {
                x: 0px; y: 0px;
                width: root.width - 48px;
                height: knowledge-scroll.content-height;
                spacing: 0px;
                Rectangle { min-height: root.has-prompt ? 16px : 0px; vertical-stretch: 1; background: transparent; }
                knowledge-prompt := FormulaLabel {
                    visible: root.has-prompt;
                    fallback: root.prompt; formula: root.prompt-formula;
                    formula-width: root.prompt-formula-width; formula-height: root.prompt-formula-height;
                    texts: root.prompt-texts; font-size: 22px;
                    min-height: root.has-prompt ? 48px : 0px;
                    max-height: root.has-prompt ? max(48px, self.preferred-height) : 0px;
                    vertical-stretch: 0;
                }
                if root.has-prompt && root.question-image-width > 0 : Rectangle { height: 16px; background: transparent; }
                if root.question-image-width > 0 : QuestionPicture {
                    picture: root.question-image; picture-width: root.question-image-width; picture-height: root.question-image-height;
                    vertical-stretch: 0;
                    activated => { root.preview-question-image(); }
                }
                if root.standard-answer != "" : Rectangle { height: 24px; background: transparent; }
                if root.standard-answer != "" : FormulaLabel {
                    fallback: root.standard-answer; formula: root.answer-formula;
                    formula-width: root.answer-formula-width; formula-height: root.answer-formula-height;
                    texts: root.answer-texts; font-size: 20px; min-height: 32px; vertical-stretch: 0;
                }
                Rectangle { min-height: root.has-prompt ? 16px : 0px; vertical-stretch: 1; background: transparent; }
            }
        }
        if root.knowledge-only : Text {
            x: 24px; y: parent.height - 24px; width: parent.width - 48px; height: 14px;
            text: @tr("知识展示 · 无需作答"); color: Theme.muted; font-size: 10px;
            horizontal-alignment: center; vertical-alignment: center;
        }
        practice-scroll := ScrollView {
            visible: !root.knowledge-only;
            x: 24px; y: 24px + root.tag-space;
            width: parent.width - 36px; height: parent.height - 42px - root.tag-space;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            content-height: max(self.visible-height, root.practice-content-height);
            VerticalLayout {
                x: 0px; y: 0px;
                width: root.width - 48px;
                height: practice-scroll.content-height;
                spacing: 0px;
                practice-prompt := FormulaLabel {
                    visible: root.has-prompt;
                    fallback: root.prompt;
                    formula: root.prompt-formula;
                    formula-width: root.prompt-formula-width;
                    formula-height: root.prompt-formula-height;
                    texts: root.prompt-texts;
                    font-size: 24px;
                    min-height: root.has-prompt ? 48px : 0px;
                    max-height: root.has-prompt ? max(48px, self.preferred-height) : 0px;
                    vertical-stretch: root.has-prompt ? 1 : 0;
                }
                if root.has-prompt && root.question-image-width > 0 : Rectangle { height: 14px; vertical-stretch: 0; background: transparent; }
                if root.question-image-width > 0 : QuestionPicture {
                    picture: root.question-image; picture-width: root.question-image-width; picture-height: root.question-image-height;
                    vertical-stretch: 0;
                    activated => { root.preview-question-image(); }
                }
                Rectangle { height: 20px; background: transparent; }
                Rectangle {
                    height: root.answer-row-height;
                    background: transparent;
                    Rectangle {
                        visible: root.answer-mode == 0;
                        width: parent.width; height: parent.height;
                        background: root.feedback == 1 ? Theme.correct-soft : root.feedback == 2 ? Theme.wrong-soft : Theme.soft;
                        border-radius: 7px;
                        border-width: root.feedback == 0 ? 1px : 2px;
                        border-color: root.feedback == 1 ? Theme.correct-ink : root.feedback == 2 || root.input-error != "" ? Theme.wrong-ink : answer-input.has-focus || MathInputState.open ? Theme.focus : Theme.control-border;
                        accessible-role: text-input;
                        accessible-label: @tr("你的答案");
                        if root.input-error != "" : Tooltip { text: @markdown("\{root.input-error}"); }
                        answer-input := StructuredMathSurface {
                            visible: root.feedback == 0;
                            x: 0px; y: 0px; width: parent.width - 42px; height: parent.height;
                            framed: false;
                            structured: MathInputState.open;
                            enabled: root.feedback == 0;
                            plain-input: root.answer-text;
                            plain-anchor: root.answer-position.anchor;
                            plain-caret: root.answer-position.caret;
                            plain-revision: root.answer-position.revision;
                            plain-edited(value) => { root.answer-edited(value); }
                            plain-position-changed(value, anchor, caret) => { root.answer-position-changed(value, anchor, caret); }
                            plain-command(value) => { root.input-command(value); }
                            submitted => { root.submit-answer(root.answer-text); }
                        }
                        if root.feedback != 0 : FormulaLabel {
                            x: 12px; y: 8px; width: parent.width - 62px; height: parent.height - 16px;
                            fallback: root.answer-text; formula: root.input-preview.formula;
                            formula-width: root.input-preview.formula-width; formula-height: root.input-preview.formula-height;
                            texts: root.input-preview.texts; font-size: 22px;
                            ink: root.feedback == 1 ? Theme.correct-ink : Theme.wrong-ink;
                            formula-tint: root.feedback == 1 ? Theme.correct-ink : Theme.wrong-ink;
                        }
                        formula-toggle := ToolButton {
                            x: parent.width - 38px; y: (parent.height - 32px) / 2;
                            width: 32px; height: 32px;
                            label: "ƒ"; name: MathInputState.open && MathInputState.keypad-expanded ? @tr("收起公式输入") : @tr("公式输入");
                            enabled: root.feedback == 0;
                            activated => {
                                if MathInputState.open {
                                    MathInputState.keypad-expanded = !MathInputState.keypad-expanded;
                                    MathInputState.focus-request += 1;
                                } else { root.open-structured-entry(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        visible: root.answer-mode != 0;
                        width: parent.width; height: parent.height;
                        spacing: 8px;
                        for option[index] in root.options : AnswerTile {
                            option: option;
                            symbol-only: root.answer-mode == 2;
                            symbol: index == 0 ? @image-url("../assets/check_mark.svg") : @image-url("../assets/cross_mark.svg");
                            enabled: root.feedback == 0;
                            feedback: root.selected-option == index ? root.feedback : 0;
                            activated => { root.choose-answer(index); }
                        }
                    }
                }
                answer-footer := Rectangle {
                    height: root.answer-footer-height;
                    vertical-stretch: 0;
                    background: transparent;
                    if MathInputState.open : StructuredMathPad {
                        visible: MathInputState.keypad-expanded;
                        x: 0px; y: 13px; width: parent.width;
                        changed natural-height => { root.structured-pad-height = self.natural-height; }
                        init => { root.structured-pad-height = self.natural-height; }
                    }
                    structured-error := Text {
                        visible: MathInputState.open && !MathInputState.keypad-expanded && MathInputState.error != "";
                        x: 0px; y: 13px; width: parent.width; height: self.preferred-height;
                        text: MathInputState.error; color: Theme.wrong-ink; font-size: 12px; wrap: word-wrap;
                    }
                    standard-label := FormulaLabel {
                        visible: root.feedback == 2;
                        x: 0px; y: 13px;
                        width: parent.width;
                        height: parent.height - 39px;
                        fallback: root.standard-answer;
                        formula: root.answer-formula;
                        formula-width: root.answer-formula-width;
                        formula-height: root.answer-formula-height;
                        texts: root.answer-texts;
                        font-size: 20px;
                        ink: Theme.wrong-ink;
                    }
                    if root.feedback == 2 : Text {
                        y: parent.height - 16px;
                        width: parent.width; height: 16px;
                        text: @tr("按 Enter 确认");
                        font-size: 12px; color: Theme.wrong-ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
