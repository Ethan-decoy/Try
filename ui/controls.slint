import { Theme } from "theme.slint";

export component FocusOutline inherits Rectangle {
    in property <color> ink: Theme.focus;
    Rectangle {
        x: 2px; y: 2px;
        width: max(0px, parent.width - 4px); height: max(0px, parent.height - 4px);
        border-radius: 5px; border-width: 2px; border-color: root.ink;
        background: transparent;
    }
}

export component KeyboardFocus inherits FocusScope {
    private property <bool> pointer-focused;
    out property <bool> show-focus: root.has-focus && !root.pointer-focused;

    public function focus-from-pointer() {
        root.pointer-focused = true;
        root.focus();
    }
    public function show-keyboard-focus() { root.pointer-focused = false; }

    capture-key-pressed => { root.show-keyboard-focus(); return reject; }
    focus-lost(reason) => {
        // Dismissing a popup restores the previous focus.
        if reason != FocusReason.popup-activation { root.pointer-focused = false; }
    }
}

export component EntranceMotion inherits Rectangle {
    in property <bool> play-on-init;
    in property <duration> duration: 210ms;
    private property <bool> motion-enabled: Theme.spatial-motion;
    private property <bool> interpolate;
    private property <float> progress: 1;
    out property <float> remaining: root.motion-enabled ? 1 - root.progress : 0;
    out property <float> alpha: 1 - 0.52 * root.remaining;
    width: 0px;
    height: 0px;
    animate progress {
        duration: root.interpolate && root.motion-enabled ? root.duration : 0ms;
        easing: cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    public function play(animated: bool) {
        root.interpolate = false;
        if animated && root.motion-enabled {
            root.progress = 0;
            root.interpolate = true;
        }
        root.progress = 1;
    }
    init => { if root.play-on-init { root.play(true); } }
    changed motion-enabled => { if !root.motion-enabled { root.play(false); } }
}

export component IconButton inherits Rectangle {
    in property <image> glyph;
    in property <length> glyph-size: 18px;
    in property <string> label;
    in property <bool> destructive;
    in property <color> ink: root.destructive ? Theme.danger-ink : Theme.focus;
    in property <bool> tint: true;
    in property <bool> borderless;
    in property <bool> highlighted;
    out property <bool> hovered: icon-touch.has-hover || root.highlighted;
    out property <bool> pointer-activation;
    in property <bool> enabled: true;
    in property <bool> checkable;
    in property <bool> checked;
    in property <bool> notification;
    in property <color> notification-background: Theme.canvas;
    callback activated();
    forward-focus: icon-focus;
    width: 36px; height: 36px;
    border-radius: 6px;
    border-width: !root.borderless && icon-focus.has-focus ? 1px : 0px;
    border-color: Theme.focus;
    background: !root.enabled ? transparent
        : icon-touch.pressed ? (root.destructive ? Theme.danger-soft : Theme.focus.with-alpha(0.18))
        : root.hovered ? (root.destructive ? Theme.danger-soft : Theme.hover) : transparent;
    animate background { duration: icon-touch.pressed ? 0ms : Theme.tint-duration; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { if root.enabled { root.activated(); } }
    Image {
        source: root.glyph;
        width: root.glyph-size; height: root.glyph-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (icon-touch.pressed && Theme.spatial-motion ? 1phx : 0px);
        colorize: !root.tint ? transparent : root.enabled ? root.ink : Theme.disabled;
    }
    if root.borderless && icon-focus.has-focus : FocusOutline { }
    Tooltip { text: @markdown("\{root.label}"); }
    icon-focus := FocusScope {
        enabled: root.enabled;
        width: root.borderless ? 0px : parent.width;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; }
            return reject;
        }
    }
    icon-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            if !root.borderless { icon-focus.focus(); }
            root.pointer-activation = true;
            root.activated();
            root.pointer-activation = false;
        }
    }
    Rectangle {
        visible: root.notification;
        x: parent.width / 2 + 6px; y: parent.height / 2 - 14px;
        width: 10px; height: 10px; border-radius: 5px;
        background: Theme.danger-ink;
        border-width: 2px; border-color: root.notification-background;
    }
}

export component TextLink inherits Rectangle {
    in property <string> label;
    in property <string> name: root.label;
    in property <length> font-size: 14px;
    in property <color> ink: Theme.ink;
    in property <bool> centered;
    out property <bool> pointer-activation;
    callback activated();
    forward-focus: link-focus;
    width: 160px; height: 36px;
    background: transparent;
    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => { root.activated(); }
    Text {
        width: 100%; height: 100%;
        text: root.label;
        color: link-touch.has-hover ? Theme.ink : root.ink;
        font-size: root.font-size;
        horizontal-alignment: root.centered ? center : left;
        vertical-alignment: center;
    }
    if link-focus.has-focus : Rectangle {
        x: root.centered ? 12px : 0px; y: parent.height - 4px;
        width: root.centered ? parent.width - 24px : 18px; height: 1px;
        background: Theme.focus;
    }
    link-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; }
            return reject;
        }
    }
    link-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pointer-activation = true; root.activated(); root.pointer-activation = false; }
    }
}

export component SettingsCheck inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> checkbox-right;
    callback toggled(bool);
    forward-focus: check-focus;
    height: 36px;
    horizontal-stretch: 1;
    min-width: 0px;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(!root.checked); } }
    Rectangle {
        x: root.checkbox-right ? parent.width - self.width : 0px;
        y: 8px; width: 20px; height: 20px;
        border-radius: 4px;
        border-width: root.checked ? 0px : 1px;
        border-color: check-touch.has-hover ? Theme.focus : Theme.control-border;
        background: root.checked ? (root.enabled ? Theme.primary : Theme.disabled) : Theme.panel;
        if root.checked : Image { source: @image-url("../assets/check_mark.svg"); colorize: Theme.primary-ink; x: 3px; y: 3px; width: 14px; height: 14px; }
    }
    Text { x: root.checkbox-right ? 0px : 30px; width: parent.width - 30px; height: parent.height; text: root.text; color: !root.enabled ? Theme.disabled : Theme.ink; vertical-alignment: center; overflow: elide; }
    if check-focus.has-focus : Rectangle { x: root.checkbox-right ? parent.width - 19px : 1px; y: parent.height - 3px; width: 18px; height: 2px; border-radius: 1px; background: Theme.focus; }
    if root.hint != "" : Tooltip { text: @markdown("\{root.hint}"); }
    check-focus := FocusScope {
        width: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.toggled(!root.checked); return accept; }
            return reject;
        }
    }
    check-touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
}

export component AnswerPick inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> selected;
    in property <bool> symbol-only;
    in property <bool> compact;
    in property <image> glyph;
    in property <string> label;
    callback activated();
    forward-focus: pick-focus;
    width: 36px; height: 36px;
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.5;
    background: root.compact ? transparent : root.symbol-only && root.selected ? Theme.primary : pick-touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { if root.enabled { root.activated(); } }
    Rectangle {
        visible: !root.symbol-only;
        x: (parent.width - 20px) / 2; y: (parent.height - 20px) / 2;
        width: 20px; height: 20px; border-radius: 10px;
        border-width: 1px; border-color: root.selected ? Theme.primary : Theme.control-border;
        background: root.selected ? Theme.primary : transparent;
        Rectangle { visible: root.selected; x: 6px; y: 6px; width: 8px; height: 8px; border-radius: 4px; background: Theme.primary-ink; }
    }
    if root.symbol-only && root.compact : Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: 28px; height: 22px; border-radius: 4px;
        background: root.selected ? Theme.primary : pick-touch.has-hover ? Theme.hover : transparent;
    }
    Image { visible: root.symbol-only; source: root.glyph; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: root.compact ? 16px : 20px; height: self.width; colorize: root.selected ? Theme.primary-ink : Theme.muted; }
    if pick-focus.has-focus : FocusOutline { }
    Tooltip { text: @markdown("\{root.label}"); }
    pick-focus := FocusScope {
        width: 0px; enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; } return reject; }
    }
    pick-touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.activated(); } }
}

export component ParticipationSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> partial;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> borderless;
    callback toggled(bool);
    forward-focus: switch-focus;
    width: 48px; height: 42px;
    border-radius: 6px;
    background: !root.borderless && switch-touch.has-hover && root.enabled ? Theme.soft : transparent;
    border-width: !root.borderless && switch-focus.has-focus ? 1px : 0px;
    border-color: Theme.focus;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(!root.checked); } }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: 28px; height: 16px;
        border-radius: 8px; border-width: 1px;
        border-color: !root.enabled ? Theme.border : switch-touch.has-hover ? Theme.focus : root.checked ? Theme.switch-on : Theme.control-border;
        background: !root.enabled ? Theme.soft : root.checked ? Theme.switch-on : Theme.switch-off;
        animate background, border-color { duration: Theme.tint-duration; easing: ease-out; }
        Rectangle {
            x: root.checked ? 15px : root.partial ? 8px : 3px;
            y: 3px; width: 10px; height: 10px; border-radius: 5px;
            background: root.enabled ? white : Theme.disabled;
            animate x { duration: Theme.switch-duration; easing: ease-out; }
        }
    }
    Tooltip { text: @markdown("\{root.label}"); }
    if root.borderless && switch-focus.has-focus : FocusOutline { }
    switch-focus := FocusScope {
        enabled: root.enabled;
        width: root.borderless ? 0px : parent.width;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.toggled(!root.checked); return accept; }
            return reject;
        }
    }
    switch-touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { if !root.borderless { switch-focus.focus(); } root.toggled(!root.checked); }
    }
}


export component Disclosure inherits Rectangle {
    in property <string> label;
    in property <string> summary;
    in property <bool> expanded;
    in property <bool> enabled: true;
    in property <length> font-size: 14px;
    in property <int> font-weight: 400;
    out property <bool> pointer-activation;
    callback activated();
    forward-focus: disclosure-focus;
    preferred-width: label-text.preferred-width + 30px;
    min-width: 0px;
    height: 36px;
    border-radius: 4px;
    background: transparent;
    accessible-role: button;
    accessible-label: (root.expanded ? @tr("收起：") : @tr("展开：")) + root.label;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-default => { if root.enabled { disclosure-focus.show-keyboard-focus(); root.activated(); } }
    HorizontalLayout {
        spacing: 8px;
        label-text := Text { text: root.label; font-size: root.font-size; font-weight: root.font-weight; color: !root.enabled ? Theme.disabled : root.expanded || disclosure-touch.has-hover ? Theme.ink : Theme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 0; }
        Rectangle { width: 16px; Image { source: root.expanded ? @image-url("../assets/chevron_up.svg") : @image-url("../assets/chevron.svg"); width: 16px; height: 16px; y: (parent.height - self.height) / 2; colorize: disclosure-touch.has-hover && root.enabled ? Theme.ink : Theme.muted; } }
        if root.summary != "" : Text { text: root.summary; font-size: 12px; color: Theme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if root.summary == "" : Rectangle { horizontal-stretch: 1; background: transparent; }
    }
    if disclosure-focus.show-focus : Rectangle {
        x: -4px; y: 2px;
        width: min(parent.width + 4px, label-text.preferred-width + 32px); height: parent.height - 4px;
        border-radius: 4px; border-width: 1px; border-color: Theme.focus;
        background: transparent;
    }
    disclosure-focus := KeyboardFocus {
        width: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; }
            return reject;
        }
    }
    disclosure-touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => {
            disclosure-focus.focus-from-pointer();
            root.pointer-activation = true; root.activated(); root.pointer-activation = false;
        }
    }
}

export component ToolButton inherits Rectangle {
    in property <string> label;
    in property <string> name;
    in property <image> glyph;
    in property <bool> icon-only;
    in property <bool> enabled: true;
    in property <bool> checkable;
    in property <bool> checked;
    in property <bool> destructive;
    in property <length> font-size: 16px;
    out property <bool> pointer-activation;
    callback activated();
    forward-focus: tool-focus;
    preferred-width: 32px;
    min-width: 28px;
    horizontal-stretch: 1;
    height: 32px;
    border-radius: 4px;
    background: root.checked ? Theme.selected : tool-touch.has-hover && root.enabled ? (root.destructive ? Theme.danger-soft : Theme.hover) : Theme.soft;
    opacity: root.enabled ? 1 : 0.4;
    border-width: tool-focus.has-focus ? 1px : 0px;
    border-color: Theme.focus;
    accessible-role: button;
    accessible-label: root.name;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { if root.enabled { root.activated(); } }
    Text { visible: !root.icon-only; text: root.label; color: root.destructive ? Theme.danger-ink : Theme.ink; font-size: root.font-size; horizontal-alignment: center; vertical-alignment: center; }
    Image { visible: root.icon-only; source: root.glyph; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Theme.ink; }
    Tooltip { text: @markdown("\{root.name}"); }
    tool-focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; } return reject; }
    }
    tool-touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { root.pointer-activation = true; root.activated(); root.pointer-activation = false; }
    }
}
