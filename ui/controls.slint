import { Theme } from "theme.slint";
export component IconButton inherits Rectangle {
    in property <image> glyph;
    in property <length> glyph-size: 18px;
    in property <string> label;
    in property <color> ink: Theme.focus;
    in property <bool> tint: true;
    in property <bool> borderless;
    in property <bool> enabled: true;
    in property <bool> checkable;
    in property <bool> checked;
    callback activated();
    forward-focus: icon-focus;
    width: 36px; height: 36px;
    border-radius: 6px;
    border-width: !root.borderless && icon-focus.has-focus ? 1px : 0px;
    border-color: Theme.focus;
    background: icon-touch.has-hover && root.enabled ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { if root.enabled { root.activated(); } }
    Image {
        source: root.glyph;
        width: root.glyph-size; height: root.glyph-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: !root.tint ? transparent : root.enabled ? root.ink : Theme.disabled;
    }
    if root.borderless && icon-focus.has-focus : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 4px;
        width: 18px; height: 2px;
        border-radius: 1px;
        background: Theme.focus;
    }
    Tooltip { text: @markdown("\{root.label}"); }
    icon-focus := FocusScope {
        enabled: root.enabled;
        width: root.borderless ? 0px : parent.width;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; }
            return reject;
        }
    }
    icon-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { if !root.borderless { icon-focus.focus(); } root.activated(); }
    }
}

export component TextLink inherits Rectangle {
    in property <string> label;
    in property <string> name: root.label;
    in property <length> font-size: 14px;
    in property <color> ink: Theme.ink;
    in property <bool> centered;
    callback activated();
    forward-focus: link-focus;
    width: 160px; height: 36px;
    background: transparent;
    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => { root.activated(); }
    Text {
        width: 100%; height: 100%;
        text: root.label;
        color: link-touch.has-hover ? Theme.ink : root.ink;
        font-size: root.font-size;
        horizontal-alignment: root.centered ? center : left;
        vertical-alignment: center;
    }
    if link-focus.has-focus : Rectangle {
        x: root.centered ? 12px : 0px; y: parent.height - 4px;
        width: root.centered ? parent.width - 24px : 18px; height: 1px;
        background: Theme.focus;
    }
    link-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; }
            return reject;
        }
    }
    link-touch := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

export component SettingsCheck inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> checkbox-right;
    callback toggled(bool);
    forward-focus: check-focus;
    height: 36px;
    horizontal-stretch: 1;
    min-width: 0px;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(!root.checked); } }
    Rectangle {
        x: root.checkbox-right ? parent.width - self.width : 0px;
        y: 8px; width: 20px; height: 20px;
        border-radius: 4px;
        border-width: root.checked ? 0px : 1px;
        border-color: check-touch.has-hover ? Theme.focus : Theme.control-border;
        background: root.checked ? (root.enabled ? Theme.primary : Theme.disabled) : Theme.panel;
        if root.checked : Image { source: @image-url("../assets/check_mark.svg"); colorize: Theme.primary-ink; x: 3px; y: 3px; width: 14px; height: 14px; }
    }
    Text { x: root.checkbox-right ? 0px : 30px; width: parent.width - 30px; height: parent.height; text: root.text; color: !root.enabled ? Theme.disabled : Theme.ink; vertical-alignment: center; overflow: elide; }
    if check-focus.has-focus : Rectangle { x: root.checkbox-right ? parent.width - 19px : 1px; y: parent.height - 3px; width: 18px; height: 2px; border-radius: 1px; background: Theme.focus; }
    if root.hint != "" : Tooltip { text: @markdown("\{root.hint}"); }
    check-focus := FocusScope {
        width: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.toggled(!root.checked); return accept; }
            return reject;
        }
    }
    check-touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
}

export component AnswerPick inherits Rectangle {
    in property <bool> selected;
    in property <bool> symbol-only;
    in property <bool> compact;
    in property <image> glyph;
    in property <string> label;
    callback activated();
    forward-focus: pick-focus;
    width: 36px; height: 36px;
    border-radius: 6px;
    background: root.compact ? transparent : root.symbol-only && root.selected ? Theme.primary : pick-touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.activated(); }
    Rectangle {
        visible: !root.symbol-only;
        x: (parent.width - 20px) / 2; y: (parent.height - 20px) / 2;
        width: 20px; height: 20px; border-radius: 10px;
        border-width: 1px; border-color: root.selected ? Theme.primary : Theme.control-border;
        background: root.selected ? Theme.primary : transparent;
        Rectangle { visible: root.selected; x: 6px; y: 6px; width: 8px; height: 8px; border-radius: 4px; background: Theme.primary-ink; }
    }
    if root.symbol-only && root.compact : Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: 28px; height: 22px; border-radius: 4px;
        background: root.selected ? Theme.primary : pick-touch.has-hover ? Theme.hover : transparent;
    }
    Image { visible: root.symbol-only; source: root.glyph; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: root.compact ? 16px : 20px; height: self.width; colorize: root.selected ? Theme.primary-ink : Theme.muted; }
    if pick-focus.has-focus : Rectangle { x: (parent.width - 18px) / 2; y: parent.height - 2px; width: 18px; height: 2px; background: Theme.focus; }
    Tooltip { text: @markdown("\{root.label}"); }
    pick-focus := FocusScope {
        width: 0px;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; } return reject; }
    }
    pick-touch := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

export component ParticipationSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> partial;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> borderless;
    callback toggled(bool);
    forward-focus: switch-focus;
    width: 48px; height: 42px;
    border-radius: 6px;
    background: switch-touch.has-hover && root.enabled ? Theme.soft : transparent;
    border-width: !root.borderless && switch-focus.has-focus ? 1px : 0px;
    border-color: Theme.focus;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(!root.checked); } }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: 28px; height: 16px;
        border-radius: 8px; border-width: 1px;
        border-color: !root.enabled ? Theme.border : root.checked ? Theme.primary : Theme.control-border;
        background: root.checked ? Theme.primary : root.partial ? Theme.hover : Theme.soft;
        Rectangle {
            x: root.checked ? 15px : root.partial ? 8px : 3px;
            y: 3px; width: 10px; height: 10px; border-radius: 5px;
            background: root.checked ? Theme.primary-ink : root.enabled ? Theme.muted : Theme.disabled;
        }
    }
    Tooltip { text: @markdown("\{root.label}"); }
    if root.borderless && switch-focus.has-focus : Rectangle {
        x: (parent.width - self.width) / 2; y: parent.height - 3px;
        width: 18px; height: 2px; border-radius: 1px; background: Theme.focus;
    }
    switch-focus := FocusScope {
        enabled: root.enabled;
        width: root.borderless ? 0px : parent.width;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.toggled(!root.checked); return accept; }
            return reject;
        }
    }
    switch-touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { if !root.borderless { switch-focus.focus(); } root.toggled(!root.checked); }
    }
}

export component MatrixCell inherits Rectangle {
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <string> label;
    callback activated();
    forward-focus: cell-focus;
    width: 58px; height: 42px;
    border-radius: 6px;
    background: cell-touch.has-hover && root.enabled ? Theme.soft : transparent;
    border-width: cell-focus.has-focus ? 1px : 0px;
    border-color: Theme.focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { if root.enabled { root.activated(); } }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: root.selected ? 28px : 14px;
        height: root.selected ? 22px : root.enabled ? 4px : 2px;
        border-radius: root.selected ? 4px : 2px;
        background: root.selected ? Theme.primary : root.enabled ? Theme.disabled : Theme.soft;
        if root.selected : Image { source: @image-url("../assets/check_mark.svg"); colorize: Theme.primary-ink; x: 6px; y: 3px; width: 16px; height: 16px; }
    }
    Tooltip { text: @markdown("\{root.label}"); }
    cell-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; }
            return reject;
        }
    }
    cell-touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { cell-focus.focus(); root.activated(); }
    }
}

export component Disclosure inherits Rectangle {
    in property <string> label;
    in property <bool> expanded;
    in property <length> font-size: 14px;
    in property <int> font-weight: 400;
    callback activated();
    forward-focus: disclosure-focus;
    preferred-width: label-text.preferred-width + 30px;
    min-width: 0px;
    height: 36px;
    accessible-role: button;
    accessible-label: (root.expanded ? @tr("收起：") : @tr("展开：")) + root.label;
    accessible-action-default => { root.activated(); }
    HorizontalLayout {
        spacing: 8px;
        label-text := Text { text: root.label; font-size: root.font-size; font-weight: root.font-weight; color: disclosure-touch.has-hover ? Theme.ink : Theme.ink; vertical-alignment: center; overflow: elide; }
        Rectangle { width: 16px; Image { source: root.expanded ? @image-url("../assets/chevron_up.svg") : @image-url("../assets/chevron.svg"); width: 16px; height: 16px; y: (parent.height - self.height) / 2; colorize: Theme.muted; } }
    }
    if disclosure-focus.has-focus : Rectangle {
        x: 0px; y: parent.height - 2px;
        width: 18px; height: 2px;
        border-radius: 1px;
        background: Theme.focus;
    }
    disclosure-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; }
            return reject;
        }
    }
    disclosure-touch := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}
