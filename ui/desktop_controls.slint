import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

// Desktop actions share keyboard, pointer and accessibility behavior.
export component DesktopButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> text;
    in property <image> glyph;
    in property <bool> primary;
    in property <bool> selected;
    in property <bool> highlighted;
    in property <bool> destructive;
    in property <bool> caution;
    out property <bool> has-focus: keyboard.has-focus;
    private property <bool> hovered: root.highlighted || hit-area.has-hover;
    private property <color> action-ink: root.destructive ? Theme.danger-ink : root.caution ? Theme.caution-ink : Theme.ink;
    private property <color> filled-ink: root.destructive ? Theme.on-danger : root.caution ? Theme.on-caution : Theme.primary-ink;
    private property <color> filled-background: root.destructive ? (hit-area.pressed ? Theme.danger-pressed : root.hovered ? Theme.danger-hover : Theme.danger) : root.caution ? (root.hovered ? Theme.caution-hover : Theme.caution) : Theme.primary;
    private property <color> hover-background: root.destructive ? Theme.danger-soft : root.caution ? Theme.caution-soft : Theme.hover;
    callback activated();
    height: 32px;
    min-width: 0px;
    preferred-width: caption.preferred-width + (root.glyph.width > 0 ? 48px : 24px);
    horizontal-stretch: 0;
    border-radius: 6px;
    background: !root.enabled ? (root.primary ? Theme.soft : transparent) : root.primary ? root.filled-background : root.selected ? Theme.selected : root.hovered ? root.hover-background : transparent;
    border-width: keyboard.has-focus || (root.primary && root.caution) ? 1px : 0px;
    border-color: keyboard.has-focus ? Theme.focus : Theme.caution-ink;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: root.selected;
    accessible-checked: root.selected;
    accessible-action-default => { if root.enabled { root.activated(); } }
    forward-focus: keyboard;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 6px;
        if root.glyph.width > 0 : Image {
            source: root.glyph; width: 15px; height: 15px;
            y: (parent.height - self.height) / 2;
            colorize: root.primary && root.enabled ? root.filled-ink : root.destructive || root.caution ? root.action-ink : Theme.muted;
        }
        caption := Text {
            text: root.text;
            color: root.primary && root.enabled ? root.filled-ink : root.action-ink;
            font-size: 13px; vertical-alignment: center; overflow: elide;
        }
    }
    keyboard := FocusScope {
        width: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; }
            return reject;
        }
    }
    hit-area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.activated(); } }
}

// A window-local modal keeps deletion in context without resizing the page.
export component DeleteConfirmation inherits Rectangle {
    in property <bool> opened;
    in property <string> title;
    in property <string> message;
    in property <string> error;
    callback confirmed();
    callback cancelled();
    out property <length> panel-left: panel.absolute-position.x;
    out property <length> panel-top: panel.absolute-position.y;
    out property <length> panel-width: panel.width;
    out property <length> panel-height: panel.height;
    out property <length> confirm-center-x: confirm-button.absolute-position.x + confirm-button.width / 2;
    out property <length> confirm-center-y: confirm-button.absolute-position.y + confirm-button.height / 2;
    out property <length> cancel-center-x: cancel-button.absolute-position.x + cancel-button.width / 2;
    out property <length> cancel-center-y: cancel-button.absolute-position.y + cancel-button.height / 2;
    out property <bool> cancel-focused: cancel-button.has-focus;
    out property <bool> confirm-focused: confirm-button.has-focus;
    visible: root.opened;
    background: Theme.scrim;
    forward-focus: dialog-focus;
    init => { if root.opened { cancel-button.focus(); } }
    changed opened => { if root.opened { cancel-button.focus(); } }
    backdrop := TouchArea {
        enabled: root.opened;
        clicked => { cancel-button.focus(); }
        scroll-event(event) => { return accept; }
    }
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height; enabled: root.opened;
        // Route keys without intercepting the backdrop's pointer events.
        focus-on-click: false;
        forward-focus: cancel-button;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancelled(); return accept; }
            if event.text == Key.Tab {
                if cancel-button.has-focus { confirm-button.focus(); } else { cancel-button.focus(); }
                return accept;
            }
            return reject;
        }
        panel := Rectangle {
            width: min(420px, parent.width - 48px);
            height: dialog-content.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel; border-radius: 10px;
            border-width: 1px; border-color: Theme.danger-ink;
            accessible-role: groupbox; accessible-label: root.title;
            dialog-content := VerticalLayout {
                padding: 24px; spacing: 16px;
                Text { text: root.title; color: Theme.ink; font-size: 18px; font-weight: 600; wrap: word-wrap; }
                details := ScrollView {
                    height: min(180px, max(32px, details-content.preferred-height));
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, details-content.preferred-height);
                    details-content := VerticalLayout {
                        width: max(0px, details.visible-width - 14px);
                        spacing: 8px;
                        Text { text: root.message; color: Theme.ink; font-size: 13px; wrap: word-wrap; }
                        if root.error != "" : Text { text: root.error; color: Theme.danger-ink; font-size: 13px; wrap: word-wrap; }
                    }
                }
                HorizontalLayout {
                    height: 32px; spacing: 8px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    cancel-button := DesktopButton { text: @tr("取消"); activated => { root.cancelled(); } }
                    confirm-button := DesktopButton { text: root.title; primary: true; destructive: true; activated => { root.confirmed(); } }
                }
            }
        }
    }
}

export component ParticipationCheck inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> checked;
    in property <bool> partial;
    in property <string> label;
    callback toggled(bool);
    width: 36px; height: 36px;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { if root.enabled { root.toggled(!root.checked); } }
    forward-focus: keyboard;
    opacity: root.enabled ? 1 : 0.4;
    Rectangle {
        x: (parent.width - 16px) / 2; y: (parent.height - 16px) / 2;
        width: 16px; height: 16px; border-radius: 4px;
        background: root.checked || root.partial ? Theme.primary : hit-area.has-hover ? Theme.hover : Theme.panel;
        border-width: root.checked || root.partial ? 0px : 1px;
        border-color: Theme.control-border;
        if root.checked : Image { x: 2px; y: 2px; width: 12px; height: 12px; source: @image-url("../assets/check_mark.svg"); colorize: Theme.primary-ink; }
        if root.partial && !root.checked : Rectangle { x: 4px; y: 7px; width: 8px; height: 2px; background: Theme.primary-ink; }
    }
    if keyboard.has-focus : Rectangle { x: 10px; y: parent.height - 3px; width: parent.width - 20px; height: 2px; background: Theme.focus; }
    keyboard := FocusScope {
        width: 0px; enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.toggled(!root.checked); return accept; } return reject; }
    }
    hit-area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
    Tooltip { text: @markdown("\{root.label}"); }
}

// A single selection describes each question's answer mode. Unsupported modes
// remain visible with an explanation, without accepting keyboard selection.
export component AnswerModeMenu inherits Rectangle {
    in property <bool> enabled: true;
    in property <[string]> options;
    in property <int> selection: -1;
    in property <bool> choice-available;
    in property <bool> judgment-available;
    in property <bool> bulk;
    in property <string> label;
    private property <int> cursor;
    callback choose(int);
    width: 88px; height: 32px;
    accessible-role: combobox; accessible-label: root.label;
    accessible-value: root.selection < 0 ? @tr("混合题型") : root.options[root.selection];
    accessible-expandable: true;
    accessible-action-expand => { if root.enabled { root.open(); } }
    forward-focus: keyboard;
    function available(index: int) -> bool { return index == 0 || (index == 1 ? root.choice-available : root.judgment-available); }
    public function open() { root.cursor = max(0, root.selection); choices.show(); }
    function finish() { choices.close(); keyboard.focus(); }
    border-radius: 5px;
    background: hit-area.has-hover && root.enabled ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 4px;
        Text { text: root.bulk ? @tr("统一题型") : root.selection < 0 ? @tr("混合题型") : root.options[root.selection]; color: root.enabled ? Theme.muted : Theme.disabled; font-size: 12px; vertical-alignment: center; }
        Image { source: @image-url("../assets/chevron.svg"); width: 10px; height: 10px; y: (parent.height - self.height) / 2; colorize: Theme.muted; }
    }
    if keyboard.has-focus : Rectangle { x: 8px; y: parent.height - 2px; width: 16px; height: 2px; background: Theme.focus; }
    keyboard := FocusScope {
        width: 0px; enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow { root.open(); return accept; } return reject; }
    }
    hit-area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.open(); } }
    choices := PopupWindow {
        x: root.width - self.width; y: root.height + 4px;
        width: 184px; height: 116px;
        close-policy: close-on-click-outside; forward-focus: choices-focus;
        Rectangle {
            background: Theme.panel; border-radius: 8px; border-width: 1px; border-color: Theme.border;
            choices-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Home { root.cursor = 0; return accept; }
                    if event.text == Key.End { root.cursor = 2; return accept; }
                    if event.text == Key.UpArrow { root.cursor = max(0, root.cursor - 1); return accept; }
                    if event.text == Key.DownArrow { root.cursor = min(2, root.cursor + 1); return accept; }
                    if event.text == Key.Return || event.text == Key.Space { if root.available(root.cursor) { root.choose(root.cursor); root.finish(); } return accept; }
                    if event.text == Key.Escape { root.finish(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 4px; spacing: 0px;
                    for option[index] in root.options : Rectangle {
                        height: 36px; border-radius: 4px;
                        background: row-touch.has-hover || root.cursor == index ? Theme.hover : transparent;
                        accessible-role: button; accessible-label: option; accessible-enabled: root.available(index);
                        accessible-action-default => { if root.available(index) { root.choose(index); root.finish(); } }
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 8px; spacing: 6px;
                            Text { text: option; color: root.available(index) ? Theme.ink : Theme.disabled; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                            if index == root.selection : Image { source: @image-url("../assets/check_mark.svg"); width: 12px; height: 12px; y: (parent.height - self.height) / 2; colorize: Theme.ink; }
                        }
                        row-touch := TouchArea { enabled: root.available(index); mouse-cursor: pointer; clicked => { root.choose(index); root.finish(); } }
                        if !root.available(index) : Tooltip { text: @markdown("\{index == 1 ? @tr("缺少选择选项 · 点击题目补齐") : @tr("缺少判断陈述 · 点击题目补齐")}"); }
                    }
                }
            }
        }
    }
}

export component ActionMenu inherits Rectangle {
    in property <bool> enabled: true;
    in property <[string]> options;
    in property <string> label;
    in property <bool> destructive-last;
    private property <int> cursor;
    private property <bool> keyboard-used;
    callback choose(int);
    width: 32px; height: 32px;
    accessible-role: button; accessible-label: root.label;
    accessible-action-default => { if root.enabled { root.open(); } }
    forward-focus: keyboard;
    function open() { root.cursor = 0; root.keyboard-used = false; menu.show(); }
    function finish() { menu.close(); keyboard.focus(); }
    // Capture the row index before closing its popup destroys the repeated item.
    function activate(action: int) { root.finish(); root.choose(action); }
    border-radius: 5px;
    background: hit-area.has-hover && root.enabled ? Theme.hover : transparent;
    for index in 3 : Rectangle {
        x: 8px + index * 7px; y: (parent.height - 3px) / 2;
        width: 3px; height: 3px; border-radius: 1.5px;
        background: root.enabled ? Theme.muted : Theme.disabled;
    }
    if keyboard.has-focus : Rectangle { x: 8px; y: parent.height - 2px; width: 16px; height: 2px; background: Theme.focus; }
    keyboard := FocusScope {
        width: 0px; enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow { root.open(); return accept; } return reject; }
    }
    hit-area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.open(); } }
    menu := PopupWindow {
        x: root.width - self.width; y: root.height + 4px;
        width: 168px; height: root.options.length * 32px + 8px;
        close-policy: close-on-click-outside; forward-focus: menu-focus;
        Rectangle {
            background: Theme.panel; border-radius: 8px; border-width: 1px; border-color: Theme.border;
            menu-focus := FocusScope {
                key-pressed(event) => {
                    root.keyboard-used = true;
                    if event.text == Key.Home { root.cursor = 0; return accept; }
                    if event.text == Key.End { root.cursor = root.options.length - 1; return accept; }
                    if event.text == Key.UpArrow { root.cursor = max(0, root.cursor - 1); return accept; }
                    if event.text == Key.DownArrow { root.cursor = min(root.options.length - 1, root.cursor + 1); return accept; }
                    if event.text == Key.Return || event.text == Key.Space { root.activate(root.cursor); return accept; }
                    if event.text == Key.Escape { root.finish(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 4px; spacing: 0px;
                    for option[index] in root.options : DesktopButton {
                        width: parent.width; text: option;
                        highlighted: root.keyboard-used && root.cursor == index;
                        destructive: root.destructive-last && index == root.options.length - 1;
                        activated => { root.activate(index); }
                    }
                }
            }
        }
    }
}

// Shared single-selection menu for preferences and the current practice mode.
export component SelectionMenu inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> framed: true;
    in property <[string]> options;
    in property <int> selection;
    in property <string> label;
    out property <string> display-value: root.options[root.selection];
    private property <int> cursor;
    private property <bool> expanded;
    private property <bool> keyboard-used;
    callback choose(int);
    forward-focus: menu-focus;
    width: 164px; height: 36px;
    background: root.enabled && menu-touch.has-hover ? Theme.hover : root.framed ? Theme.soft : transparent;
    opacity: root.enabled ? 1 : 0.45;
    border-radius: root.framed ? 8px : 5px; border-width: root.framed ? 1px : 0px; border-color: Theme.border;
    accessible-role: combobox; accessible-label: root.label;
    accessible-value: root.display-value;
    accessible-enabled: root.enabled;
    accessible-expandable: true; accessible-expanded: root.expanded;
    accessible-action-expand => { if root.enabled { root.open(true); } }
    public function open(keyboard: bool) { root.cursor = root.selection; root.keyboard-used = keyboard; choices.show(); }
    function finish() { choices.close(); if root.keyboard-used { menu-focus.focus(); } }
    HorizontalLayout {
        padding-left: 11px; padding-right: 10px; spacing: 6px;
        Text { text: root.display-value; color: Theme.ink; font-size: 13px; vertical-alignment: center; overflow: elide; }
        Image { source: @image-url("../assets/chevron.svg"); width: 12px; height: 12px; y: (parent.height - self.height) / 2; colorize: Theme.muted; }
    }
    if menu-focus.has-focus : Rectangle { x: 11px; y: parent.height - 3px; width: 18px; height: 2px; background: Theme.focus; }
    menu-focus := FocusScope {
        width: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow || event.text == Key.UpArrow { root.open(true); return accept; }
            return reject;
        }
    }
    menu-touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.open(false); } }
    choices := PopupWindow {
        x: 0px; y: root.height + 5px;
        width: root.width; height: root.options.length * 36px + 8px;
        close-policy: close-on-click-outside;
        forward-focus: choices-focus;
        Rectangle {
            background: Theme.soft; border-width: 1px; border-color: Theme.border; border-radius: 8px;
            choices-focus := FocusScope {
                focus-changed-event => { root.expanded = self.has-focus; }
                key-pressed(event) => {
                    root.keyboard-used = true;
                    if event.text == Key.UpArrow { root.cursor = max(0, root.cursor - 1); return accept; }
                    if event.text == Key.DownArrow { root.cursor = min(root.options.length - 1, root.cursor + 1); return accept; }
                    if event.text == Key.Return || event.text == Key.Space { root.choose(root.cursor); root.finish(); return accept; }
                    if event.text == Key.Escape { root.finish(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 4px; spacing: 0px;
                    for option[index] in root.options : Rectangle {
                        height: 36px; border-radius: 4px;
                        background: (option-touch.has-hover || (root.keyboard-used && root.cursor == index)) ? Theme.hover : transparent;
                        accessible-role: button; accessible-label: option;
                        accessible-checkable: true; accessible-checked: index == root.selection;
                        accessible-action-default => { root.choose(index); root.finish(); }
                        HorizontalLayout {
                            padding-left: 7px; padding-right: 6px; spacing: 5px;
                            Text { text: option; color: Theme.ink; font-size: 13px; vertical-alignment: center; overflow: elide; }
                            Image { visible: index == root.selection; source: @image-url("../assets/check_mark.svg"); width: 12px; height: 12px; y: (parent.height - self.height) / 2; colorize: Theme.ink; }
                        }
                        option-touch := TouchArea { mouse-cursor: pointer; clicked => { root.choose(index); root.finish(); } }
                    }
                }
            }
        }
    }
}
