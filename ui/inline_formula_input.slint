import { Theme } from "theme.slint";
import { AnswerOption, FormulaLabel, MathRegion } from "content.slint";
import { FormulaInput, FormulaNavigation, FormulaPosition } from "formula_input.slint";

// The native input owns keyboard edits, IME, clipboard and source selection.
// Its ink is replaced only while the matching formula layout is available.
export component InlineFormulaInput inherits Rectangle {
    in property <string> input;
    in property <bool> enabled: true;
    in property <bool> entry-open;
    in property <color> foreground: Theme.ink;
    in property <FormulaPosition> position;
    in property <FormulaNavigation> navigation;
    in property <AnswerOption> preview;
    in property <MathRegion> caret;
    in property <[MathRegion]> selection;
    out property <bool> math-mode: !root.entry-open && root.preview.formula-width > 0 && root.preview.label == root.input;
    out property <bool> has-focus: source.has-focus;
    out property <length> canvas-left: picture.absolute-position.x + picture.formula-x;
    out property <length> canvas-top: picture.absolute-position.y + picture.formula-y;
    out property <float> canvas-scale: picture.formula-scale;
    callback edited(string);
    callback position-changed(string, int, int);
    callback command(string);
    callback accepted();
    callback pointer-select(float, float, bool);
    callback move-caret(int, bool);
    forward-focus: source;
    clip: true;
    for region in root.selection : Rectangle {
        visible: root.math-mode && root.enabled && root.has-focus;
        x: picture.formula-x + region.x * picture.formula-scale * 1px;
        y: picture.formula-y + region.y * picture.formula-scale * 1px;
        width: region.width * picture.formula-scale * 1px;
        height: region.height * picture.formula-scale * 1px;
        background: Theme.selection; border-radius: 2px;
    }
    picture := FormulaLabel {
        visible: root.math-mode;
        width: parent.width; height: parent.height;
        formula: root.preview.formula;
        formula-width: root.preview.formula-width;
        formula-height: root.preview.formula-height;
        texts: root.preview.texts;
        ink: root.foreground; formula-tint: root.foreground;
        max-scale: root.preview.formula-height > 0 ? parent.height / (root.preview.formula-height * 1px) : 1;
    }
    source := FormulaInput {
        width: parent.width; height: parent.height;
        input: root.input; position: root.position; navigation: root.navigation;
        structural-navigation: root.entry-open; shared-history: true;
        rendered: root.math-mode;
        font-size: 22px; foreground: root.foreground; alignment: center;
        enabled: root.enabled;
        edited(value) => { root.edited(value); }
        position-changed(value, anchor, caret) => { root.position-changed(value, anchor, caret); }
        command(value) => { root.command(value); }
        accepted => { root.accepted(); }
        move-caret(direction, extend) => { root.move-caret(direction, extend); }
    }
    Rectangle {
        visible: root.math-mode && root.enabled && source.has-focus && root.position.anchor == root.position.caret;
        x: picture.formula-x + root.caret.x * picture.formula-scale * 1px;
        y: picture.formula-y + root.caret.y * picture.formula-scale * 1px;
        width: 1px; height: root.caret.height * picture.formula-scale * 1px;
        background: Theme.primary;
    }
    TouchArea {
        enabled: root.math-mode && root.enabled;
        mouse-cursor: text;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                source.focus();
                root.pointer-select((self.mouse-x - picture.formula-x) / (picture.formula-scale * 1px), (self.mouse-y - picture.formula-y) / (picture.formula-scale * 1px), event.modifiers.shift);
            }
            if event.kind == PointerEventKind.move && self.pressed {
                root.pointer-select((self.mouse-x - picture.formula-x) / (picture.formula-scale * 1px), (self.mouse-y - picture.formula-y) / (picture.formula-scale * 1px), true);
            }
        }
        double-clicked => { root.move-caret(4, false); root.move-caret(5, true); }
    }
}
