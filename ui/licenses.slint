import { Theme } from "theme.slint";
import { IconButton } from "controls.slint";

component NoticeEntry inherits Rectangle {
    in property <string> name;
    in property <string> license;
    height: 40px;
    background: transparent;
    Text { width: 100%; height: 20px; text: root.name; color: Theme.ink; font-size: 14px; }
    Text { y: 22px; width: 100%; height: 18px; text: root.license; color: Theme.muted; font-size: 12px; }
}

export component ThirdPartyNotices inherits Rectangle {
    callback go-back();
    callback close-view();
    background: Theme.panel;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    forward-focus: notices-focus;
    notices-focus := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if event.text == Key.Escape { root.go-back(); return accept; }
            return reject;
        }
        IconButton {
            x: 12px; y: 15px; glyph: @image-url("../assets/back.svg");
            label: @tr("返回关于"); borderless: true; ink: Theme.muted;
            activated => { root.go-back(); }
        }
        Text { x: 56px; y: 15px; width: 184px; height: 36px; text: @tr("第三方声明"); color: Theme.ink; vertical-alignment: center; }
        IconButton {
            x: 244px; y: 15px; glyph: @image-url("../assets/cross_mark.svg");
            label: @tr("关闭声明"); borderless: true; ink: Theme.muted;
            activated => { root.close-view(); }
        }
        NoticeEntry { x: 20px; y: 68px; width: 260px; name: "Slint"; license: "Royalty-free 2.0"; }
        NoticeEntry { x: 20px; y: 110px; width: 260px; name: "slint-math-input"; license: "MIT / Apache-2.0"; }
        NoticeEntry { x: 20px; y: 152px; width: 260px; name: "latex-rust"; license: "MIT / Apache-2.0"; }
        NoticeEntry { x: 20px; y: 194px; width: 260px; name: "STIX Two Math"; license: "SIL Open Font License 1.1"; }
        Text { x: 20px; y: 244px; width: 260px; height: 28px; text: @tr("其他开源组件遵循各自许可。"); color: Theme.muted; font-size: 12px; wrap: word-wrap; }
    }
}
