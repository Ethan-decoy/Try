    in-out property <int> current-tab: 0;
    in property <bool> editor-visible;
    in property <bool> editor-new-pack;
    in property <bool> editor-can-delete;
    in property <bool> card-delete-pending;
    in property <string> card-delete-prompt;
    in property <string> editor-title;
    in-out property <int> editor-answer-mode;
    in-out property <int> editor-correct-choice;
    in-out property <int> editor-truth-choice: -1;
    in property <string> editor-error;
    in property <string> editor-preview-error;
    in property <AnswerOption> editor-prompt-preview;
    in property <AnswerOption> editor-answer-preview;
    in property <[AnswerOption]> editor-fields;
    in-out property <float> math-viewport-top;
    in-out property <float> math-viewport-height;
    in property <int> math-active-field: -1;
    in property <AnswerOption> math-preview;
    in property <[MathRegion]> math-regions;
    in property <MathRegion> math-selection;
    in property <FormulaPosition> math-position;
    in property <FormulaNavigation> math-navigation;
    in property <bool> math-text-mode;
    in property <bool> math-has-formula;
    in property <[MathTool]> math-functions;
    in property <[MathTool]> math-symbols;
    in-out property <string> math-input;
    in property <string> math-error;
    in property <bool> math-can-undo;
    in property <bool> math-can-redo;
    in property <bool> math-can-move-out;
    in property <bool> math-can-unwrap;
    in property <int> math-grid-rows;
    in property <int> math-grid-columns;
    in-out property <float> math-canvas-left;
    in-out property <float> math-canvas-top;
    in-out property <float> math-canvas-scale: 1;
    in-out property <string> editor-pack-name;
    in-out property <string> editor-prompt;
    in-out property <string> editor-answer;
    in-out property <string> editor-aliases;
    in property <image> editor-picture;
    in property <float> editor-picture-width;
    in property <float> editor-picture-height;
    in property <bool> editor-image-loading;
    out property <length> editor-picture-view-height;
    in property <bool> editor-has-image;
    in-out property <string> editor-prompt-latex;
    in-out property <string> editor-answer-latex;
    in-out property <string> editor-choice-one;
    in-out property <string> editor-choice-two;
    in-out property <string> editor-choice-one-latex;
    in-out property <string> editor-choice-two-latex;
    in-out property <string> editor-statement;
    in-out property <string> editor-statement-latex;
    in-out property <bool> editor-is-true;
    in-out property <string> editor-correction;
    in-out property <string> editor-correction-latex;
    in-out property <bool> editor-extra;
    out property <float> pixel-scale: 1px / 1phx;
    out property <length> question-area-height: content-area.height;
    out property <length> question-area-top: content-area.absolute-position.y;
    out property <length> question-area-left: content-area.absolute-position.x;
    out property <length> matrix-area-top: matrix-area.absolute-position.y;
    out property <length> matrix-area-left: matrix-area.absolute-position.x;
    out property <length> matrix-area-width: question-list.visible-width;
    out property <length> matrix-mode-width: root.mode-column;
    out property <length> matrix-answer-width: root.answer-column;
    out property <length> participation-width: root.participation-column;
    out property <length> pack-list-top: pack-list.absolute-position.y;
    out property <length> pack-list-left: pack-list.absolute-position.x;
    out property <length> pack-toggle-center-x: sidebar.absolute-position.x + sidebar.width - 34px;
    out property <length> pack-row-height: 58px;
    out property <length> pack-row-stride: 62px;
    out property <length> delete-button-center-x: pack-actions.absolute-position.x + pack-actions.width / 2;
    out property <length> delete-button-center-y: pack-actions.absolute-position.y + pack-actions.height / 2;
    out property <length> editor-cancel-center-x: editor-cancel.absolute-position.x + editor-cancel.width / 2;
    out property <length> editor-cancel-center-y: editor-cancel.absolute-position.y + editor-cancel.height / 2;
    out property <length> card-delete-center-x: delete-card-button.absolute-position.x + delete-card-button.width / 2;
    out property <length> card-delete-center-y: delete-card-button.absolute-position.y + delete-card-button.height / 2;
    out property <length> card-confirm-center-x: card-delete-dialog.confirm-center-x;
    out property <length> card-confirm-center-y: card-delete-dialog.confirm-center-y;
    out property <length> card-cancel-center-x: card-delete-dialog.cancel-center-x;
    out property <length> card-cancel-center-y: card-delete-dialog.cancel-center-y;
    out property <length> delete-confirm-center-x: pack-delete-dialog.confirm-center-x;
    out property <length> delete-confirm-center-y: pack-delete-dialog.confirm-center-y;
    out property <length> delete-cancel-center-x: pack-delete-dialog.cancel-center-x;
    out property <length> delete-cancel-center-y: pack-delete-dialog.cancel-center-y;
    out property <length> delete-dialog-left: pack-delete-dialog.panel-left;
    out property <length> delete-dialog-top: pack-delete-dialog.panel-top;
    out property <length> delete-dialog-width: pack-delete-dialog.panel-width;
    out property <length> delete-dialog-height: pack-delete-dialog.panel-height;
    out property <bool> delete-cancel-focused: pack-delete-dialog.cancel-focused;
    out property <bool> delete-confirm-focused: pack-delete-dialog.confirm-focused;
    out property <length> card-dialog-left: card-delete-dialog.panel-left;
    out property <length> card-dialog-top: card-delete-dialog.panel-top;
    out property <length> card-dialog-width: card-delete-dialog.panel-width;
    out property <length> card-dialog-height: card-delete-dialog.panel-height;
    out property <bool> card-cancel-focused: card-delete-dialog.cancel-focused;
    out property <length> about-icon-center-x: about-button.absolute-position.x + about-button.width / 2;
    out property <length> about-icon-center-y: about-button.absolute-position.y + about-button.height / 2;
    in-out property <int> settings-section <=> settings-page.section;
    out property <length> settings-left: settings-page.absolute-position.x;
    out property <length> settings-top: settings-page.absolute-position.y;
    out property <length> settings-content-top: settings-page.content-top;
    out property <length> settings-width: settings-page.width;
    out property <string> interval-display: settings-page.interval-display;
    out property <string> feedback-display: settings-page.feedback-display;
    out property <string> knowledge-display: settings-page.knowledge-display;
    out property <string> pause-display: settings-page.pause-display;
    out property <length> language-left: settings-page.language-left;
    out property <length> language-top: settings-page.language-top;
    out property <length> appearance-left: settings-page.appearance-left;
    out property <length> appearance-top: settings-page.appearance-top;
    out property <length> reminder-focus-left: settings-page.reminder-focus-left;
    out property <length> reminder-focus-top: settings-page.reminder-focus-top;
    out property <length> automatic-update-left: settings-page.automatic-update-left;
    out property <length> automatic-update-top: settings-page.automatic-update-top;
    changed pixel-scale => { if root.editor-visible { root.preview-editor(); } MathInputState.refresh-view(); }

    callback select-pack(int);
    callback toggle-pack(string, bool);
    callback toggle-all-cards(bool);
    callback toggle-card(int, bool);
    callback edit-card(int);
    callback add-card();
    callback create-pack();
    callback save-editor();
    callback cancel-editor();
    callback delete-card();
    callback delete-row(int);
    callback confirm-card-delete();
    callback cancel-card-delete();
    callback preview-editor();
    callback choose-question-image();
    callback remove-question-image();
    callback preview-question-image();
    callback request-row-formula(int);
    callback save-quick-answer(string, string, string) -> string;
    callback prepare-quick-options(string, string);
    callback choose-quick-answer(string, string, int, int) -> string;
    callback activate-content(int);
    callback select-math-region(int);
    callback edit-math-input(string);
    callback open-structured-math();
    callback math-position-changed(string, int, int);
    callback math-tool(string);
    callback math-parent();
    callback undo-math(bool);
    callback resize-math-grid(int, int);
    callback set-all-answer-modes(int);
    callback toggle-knowledge-mode();
    callback save-pack-name();
    callback save-pack-description();
    callback save-pack-tag();
    callback set-card-answer-mode(int, int);
    callback set-editor-answer-mode(int);
    callback import-pack();
    callback export-pack();
    callback delete-pack();
    callback confirm-delete();
    callback cancel-delete();
    callback confirm-import();
    callback cancel-import();
    callback choose-interval(int);
    callback choose-feedback(int);
    callback choose-knowledge-duration(int);
    callback choose-pause(int);
    callback choose-language(int);
    callback choose-appearance(int);
    callback set-pause(int);
    callback set-interval(int);
    callback set-feedback(int);
    callback set-knowledge-duration(int);
    callback set-autostart(bool);
    callback set-quiet-enabled(bool);
    callback set-quiet-range(string, string);
    callback set-corner(int);
    callback set-remember-position(bool);
    callback set-show-pack-tags(bool);
    callback set-focus-on-reminder(bool);
    callback set-auto-check-updates(bool);
    callback go-background();
    callback tray-navigation-changed();
    callback quit-app();

    public function show-about() { notices-popup.close(); about-popup.show(); }
    public function hide-about() { about-popup.close(); }
    public function show-notices() { about-popup.close(); notices-popup.show(); }
    public function hide-notices() { notices-popup.close(); }
    public function show-pause-details() { root.current-tab = 1; settings-page.show-pause-details(); }
    public function reset-editor-scroll() { root.editor-scroll-y = 0px; }
    public function reset-overview() { root.description-expanded = false; root.name-editing = false; root.description-editing = false; root.tag-editing = false; }
    public function begin-rename() { root.metadata-error = ""; root.name-draft = root.selected-name; root.name-editing = true; }
    public function begin-description-edit() { root.metadata-error = ""; root.description-draft = root.selected-description; root.description-expanded = true; root.description-editing = true; }
    public function begin-tag-edit() { root.metadata-error = ""; root.tag-draft = root.selected-tag; root.tag-editing = true; }
    public function select-truth(value: bool) { root.editor-is-true = value; root.editor-truth-choice = value ? 0 : 1; }

    HorizontalLayout {
        spacing: 0px;
        sidebar := Rectangle {
            width: root.sidebar-width;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 12px; padding-top: 10px; spacing: 8px;
                HorizontalLayout {
                    height: 36px; spacing: 0px;
                    Text { text: @tr("知识包"); color: Theme.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                    IconButton { width: 30px; height: 32px; glyph-size: 16px; glyph: @image-url("../assets/add.svg"); label: @tr("新建知识包"); borderless: true; enabled: !root.editing && !root.action-pending; activated => { root.current-tab = 0; root.create-pack(); } }
                    IconButton { width: 30px; height: 32px; glyph-size: 16px; glyph: @image-url("../assets/import_pack.svg"); label: @tr("导入知识包"); borderless: true; enabled: !root.editing && !root.action-pending; activated => { root.import-pack(); } }
                }
                pack-list := ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    VerticalLayout {
                        spacing: root.pack-row-stride - root.pack-row-height;
                        for pack[index] in root.packs : Rectangle {
                            height: root.pack-row-height; border-radius: 6px;
                            background: root.current-tab == 0 && root.selected-index == index ? Theme.selected : pack-touch.has-hover ? Theme.hover : transparent;
                            pack-view := Rectangle {
                                x: 0px; y: 0px;
                                width: parent.width - 42px; height: parent.height;
                                VerticalLayout {
                                    padding: 10px; spacing: 4px;
                                    HorizontalLayout {
                                        height: 20px; spacing: 6px;
                                        if root.show-pack-tags && pack.tag != "" : Rectangle {
                                            width: min(58px, sidebar-tag-measure.preferred-width + 10px); height: 18px;
                                            border-radius: 4px; background: Theme.panel.with-alpha(0.6);
                                            sidebar-tag-measure := Text { visible: false; text: pack.tag; font-size: 10px; }
                                            Text { x: 5px; width: parent.width - 10px; height: parent.height; text: pack.tag; font-size: 10px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                                        }
                                        Text { text: pack.name; color: Theme.ink; font-size: 13px; overflow: elide; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; vertical-alignment: center; }
                                    }
                                    Text { text: pack.detail; color: Theme.muted; font-size: 11px; overflow: elide; }
                                }
                                accessible-role: button; accessible-label: pack.name;
                                accessible-action-default => { if !root.editing && !root.action-pending { root.select-pack(index); } }
                                forward-focus: pack-focus;
                                pack-focus := FocusScope { width: 0px; enabled: !root.editing && !root.action-pending; key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.select-pack(index); return accept; } return reject; } }
                                if pack-focus.has-focus : Rectangle { x: 10px; y: parent.height - 3px; width: 20px; height: 2px; background: Theme.focus; }
                                pack-touch := TouchArea { enabled: !root.editing && !root.action-pending; mouse-cursor: pointer; clicked => { root.current-tab = 0; root.question-scroll-y = 0px; root.select-pack(index); } }
                                Tooltip { text: @markdown("\{pack.name}"); }
                            }
                            ParticipationSwitch {
                                x: parent.width - 40px; y: (parent.height - self.height) / 2;
                                width: 36px; height: 36px; borderless: true;
                                checked: pack.participating;
                                label: (pack.participating ? @tr("停止参与：") : @tr("参与练习：")) + pack.name;
                                enabled: !root.editing && !root.action-pending;
                                toggled(value) => { root.toggle-pack(pack.id, value); }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Text { text: root.participation-summary; color: Theme.muted; font-size: 11px; height: 22px; vertical-alignment: center; overflow: elide; }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    spacing: 2px;
                    IconButton { glyph: @image-url("../assets/settings.svg"); label: @tr("设置"); borderless: true; ink: root.current-tab == 1 ? Theme.focus : Theme.muted; enabled: !root.editing && !root.action-pending; activated => { root.current-tab = 1; } }
                    about-button := IconButton {
                        glyph: @image-url("../assets/info.svg");
                        label: root.update-download ? @tr("关于 Try，有可用更新") : @tr("关于 Try");
                        borderless: true; ink: Theme.muted;
                        notification: root.update-download; notification-background: Theme.sidebar;
                        activated => { root.show-about(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 44px; background: Theme.chrome;
                HorizontalLayout {
                    padding-left: root.workspace-margin; padding-right: root.workspace-margin; spacing: 8px;
                    Text { text: @tr("练习方式"); color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                    SelectionMenu {
                        width: 108px; height: 28px; y: (parent.height - self.height) / 2;
                        framed: false; options: [@tr("答题"), @tr("知识展示")];
                        selection: root.knowledge-only ? 1 : 0; label: @tr("练习方式");
                        enabled: !root.editing && !root.action-pending;
                        choose(index) => { if (index == 1) != root.knowledge-only { root.toggle-knowledge-mode(); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            VerticalLayout {
            padding: root.workspace-margin; padding-top: 18px;
            padding-bottom: 12px; spacing: 12px;
            overview := VerticalLayout {
                vertical-stretch: 0;
                spacing: 8px;
                HorizontalLayout {
                    height: 36px; spacing: 8px;
                    if root.current-tab == 0 && !root.editor-visible && root.has-selection : HorizontalLayout {
                        spacing: 4px; horizontal-stretch: 1;
                        Rectangle {
                            min-width: 0px;
                            preferred-width: max(title-measure.preferred-width, root.name-editing ? draft-measure.preferred-width : 0px) + 30px;
                            horizontal-stretch: 0; height: 36px;
                            background: transparent;
                            title-measure := Text {
                                visible: false;
                                text: root.selected-name;
                                font-size: 22px; font-weight: 600;
                            }
                            draft-measure := Text {
                                visible: false;
                                text: root.name-draft;
                                font-size: 20px; font-weight: 600;
                            }
                            if !root.name-editing : Text { width: parent.width; height: parent.height; text: root.selected-name; color: Theme.ink; font-size: 22px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                            if root.name-editing : FocusScope {
                                width: parent.width; height: parent.height;
                                forward-focus: rename-input;
                                init => { rename-input.focus(); }
                                capture-key-pressed(event) => { if event.text == Key.Escape { root.name-editing = false; return accept; } return reject; }
                                rename-input := TextInput {
                                    x: 0px; y: 0px; width: max(0px, parent.width - 30px); height: parent.height;
                                    text <=> root.name-draft;
                                    single-line: true;
                                    font-size: 20px; font-weight: 600;
                                    color: Theme.ink;
                                    vertical-alignment: center;
                                    selection-background-color: Theme.hover;
                                    selection-foreground-color: Theme.ink;
                                    accessible-label: @tr("知识包名称");
                                    accepted => { root.save-pack-name(); }
                                }
                                Rectangle {
                                    x: rename-input.x; y: parent.height - 2px;
                                    width: rename-input.width; height: 1px;
                                    background: Theme.control-border;
                                }
                            }
                        }
                        if root.name-editing : IconButton { glyph: @image-url("../assets/check_mark.svg"); label: @tr("保存知识包名称"); borderless: true; activated => { root.save-pack-name(); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    if root.current-tab == 1 || root.editor-visible : Text { text: root.current-tab == 1 ? @tr("设置") : root.editor-title; font-size: 20px; font-weight: 600; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    if root.current-tab == 0 && !root.editor-visible && !root.has-selection : Text { text: @tr("知识包"); font-size: 20px; font-weight: 600; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 1; }
                    pack-actions := ActionMenu {
                        visible: root.current-tab == 0 && !root.editor-visible && root.has-selection;
                        width: self.visible ? 32px : 0px; height: self.visible ? 32px : 0px;
                        label: @tr("知识包操作"); destructive-last: true;
                        options: [@tr("重命名"), @tr("编辑标签"), @tr("编辑介绍"), @tr("导出"), @tr("删除")];
                        enabled: !root.editing && !root.action-pending;
                        choose(index) => { if index == 0 { root.begin-rename(); } else if index == 1 { root.begin-tag-edit(); } else if index == 2 { root.begin-description-edit(); } else if index == 3 { root.export-pack(); } else { root.delete-pack(); } }
                    }
                    delete-card-button := IconButton { visible: root.editor-visible && root.editor-can-delete; width: self.visible ? 32px : 0px; height: self.visible ? 32px : 0px; glyph: @image-url("../assets/delete_pack.svg"); label: @tr("删除这道题"); borderless: true; destructive: true; enabled: self.visible && !root.action-pending; activated => { root.delete-card(); } }
                    editor-cancel := DesktopButton { visible: root.editor-visible; width: self.visible ? 64px : 0px; height: self.visible ? 32px : 0px; text: @tr("取消"); activated => { root.cancel-editor(); } }
                    if root.editor-visible : DesktopButton { text: @tr("保存"); primary: true; enabled: !root.editor-image-loading && !root.action-pending; activated => { root.save-editor(); } }
                }
                HorizontalLayout {
                    visible: root.current-tab == 0 && !root.editor-visible && root.has-selection;
                    height: self.visible ? 28px : 0px; spacing: 8px;
                    if root.show-pack-tags && root.selected-tag != "" : Rectangle {
                        width: min(100px, title-tag.preferred-width + 14px); height: 20px; y: 4px;
                        border-radius: 4px; background: Theme.soft;
                        title-tag := Text { x: 7px; width: parent.width - 14px; height: parent.height; text: root.selected-tag; font-size: 11px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                    }
                    Text { text: root.selected-card-count; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.editor-visible : HorizontalLayout {
                    height: 36px; spacing: 4px;
                    for label[index] in root.answer-mode-labels : ModeTab { label: label; selected: root.editor-answer-mode == index; enabled: !root.card-delete-pending; activated => { root.set-editor-answer-mode(index); } }
                }
                if root.current-tab == 0 && !root.editor-visible && root.has-selection : VerticalLayout {
                    spacing: 6px;
                    if root.tag-editing : HorizontalLayout {
                        height: 36px; spacing: 8px;
                        Text { text: @tr("标签"); color: Theme.muted; font-size: 13px; width: 36px; vertical-alignment: center; }
                        Rectangle {
                            horizontal-stretch: 1; min-width: 0px; preferred-width: 0px;
                            FocusScope {
                                width: parent.width; height: parent.height;
                                forward-focus: tag-input;
                                init => { tag-input.focus(); }
                                capture-key-pressed(event) => { if event.text == Key.Escape { root.tag-editing = false; root.metadata-error = ""; return accept; } return reject; }
                                tag-input := LineEdit { width: parent.width; height: parent.height; text <=> root.tag-draft; placeholder-text: @tr("留空不显示"); accessible-label: @tr("知识包标签"); accepted => { root.save-pack-tag(); } }
                            }
                        }
                        IconButton { glyph: @image-url("../assets/cross_mark.svg"); label: @tr("取消标签编辑"); borderless: true; activated => { root.tag-editing = false; root.metadata-error = ""; } }
                        IconButton {
                            glyph: @image-url("../assets/check_mark.svg");
                            label: @tr("保存知识包标签"); borderless: true;
                            enabled: !root.name-editing && !root.description-editing && !root.action-pending;
                            activated => { root.save-pack-tag(); }
                        }
                    }
                    HorizontalLayout {
                        height: 32px; spacing: 8px;
                        Disclosure {
                            height: 32px; horizontal-stretch: 1;
                            label: @tr("介绍"); font-size: 13px; font-weight: 500;
                            summary: root.description-expanded ? "" : root.selected-description-summary == "" ? @tr("尚未添加介绍") : root.selected-description-summary;
                            expanded: root.description-expanded;
                            enabled: !root.editing && !root.action-pending;
                            activated => { root.description-expanded = !root.description-expanded; }
                        }
                        if root.description-expanded && !root.description-editing : DesktopButton {
                            text: root.selected-description == "" ? @tr("添加") : @tr("编辑");
                            accessible-label: root.selected-description == "" ? @tr("添加知识包介绍") : @tr("编辑知识包介绍");
                            glyph: @image-url("../assets/edit.svg");
                            enabled: !root.editing && !root.action-pending;
                            activated => { root.begin-description-edit(); }
                        }
                    }
                    if root.description-expanded && !root.description-editing : Rectangle {
                        height: min(156px, max(56px, description-text.preferred-height + 24px));
                        border-radius: 6px; background: Theme.soft;
                        description-scroll := ScrollView {
                            x: 12px; y: 12px;
                            width: parent.width - 24px; height: parent.height - 24px;
                            horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
                            content-height: max(self.visible-height, description-text.preferred-height);
                            description-text := Text {
                                x: 0px; y: 0px; width: max(0px, description-scroll.visible-width - 14px);
                                height: self.preferred-height;
                                text: root.selected-description == "" ? @tr("说明内容范围、适用对象与必要约定。") : root.selected-description;
                                color: root.selected-description == "" ? Theme.muted : Theme.ink;
                                font-size: 13px; horizontal-alignment: left; wrap: word-wrap;
                            }
                        }
                    }
                    description-focus := FocusScope {
                        visible: root.description-editing;
                        height: root.description-editing ? 96px : 0px;
                        forward-focus: description-input;
                        init => { if self.visible { description-input.focus(); } }
                        changed visible => { if self.visible { description-input.focus(); } }
                        capture-key-pressed(event) => {
                            if event.text == Key.Escape { root.description-editing = false; return accept; }
                            if event.text == Key.Return && event.modifiers.control { root.save-pack-description(); return accept; }
                            return reject;
                        }
                        description-input := TextEdit {
                            width: parent.width; height: parent.height;
                            text <=> root.description-draft;
                            placeholder-text: @tr("说明内容范围、适用对象与必要约定。");
                            accessible-label: @tr("知识包介绍");
                        }
                    }
                    if root.description-editing : HorizontalLayout {
                        height: 36px; spacing: 4px;
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        IconButton { glyph: @image-url("../assets/cross_mark.svg"); label: @tr("取消介绍编辑"); activated => { root.description-editing = false; } }
                        IconButton { glyph: @image-url("../assets/check_mark.svg"); label: @tr("保存知识包介绍"); activated => { root.save-pack-description(); } }
                    }
                }
                if root.metadata-error != "" && (root.name-editing || root.description-editing || root.tag-editing) : Text { text: root.metadata-error; color: Theme.wrong-ink; font-size: 12px; wrap: word-wrap; }
            }
            workspace := Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
                background: transparent;
                workspace-panel := Rectangle {
                    x: 0px; y: 0px;
                    width: parent.width;
                    height: parent.height;
                    background: transparent;
                    border-radius: 0px;
                    border-width: 0px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding-left: 0px;
                        padding-right: 0px;
                        padding-top: 0px;
                        padding-bottom: 0px;
                        spacing: 0px;
                        matrix-area := Rectangle {
                            visible: root.matrix-visible; height: self.visible ? 86px : 0px;
                            VerticalLayout {
                                width: question-list.visible-width;
                                spacing: 6px;
                                HorizontalLayout {
                                    height: 36px; spacing: 0px;
                                    ParticipationCheck { width: root.participation-column; checked: root.selected-enabled; partial: root.selection-partial; label: @tr("全部参与"); enabled: root.cards.length > 0 && !root.editing && !root.action-pending; toggled(value) => { root.toggle-all-cards(value); } }
                                    Text { text: @tr("全部参与"); font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    DesktopButton { text: @tr("新增题目"); glyph: @image-url("../assets/add.svg"); enabled: !root.editing && !root.action-pending; activated => { root.add-card(); } }
                                }
                                HorizontalLayout {
                                    height: 36px; spacing: 0px;
                                    Rectangle { width: root.participation-column; }
                                    Rectangle { horizontal-stretch: 1; Text { x: 10px; width: parent.width - 10px; height: parent.height; text: @tr("提示"); font-size: 11px; color: Theme.muted; vertical-alignment: center; } }
                                    Rectangle { width: root.answer-column; Text { x: 17px; width: parent.width - 17px; height: parent.height; text: @tr("答案"); font-size: 11px; color: Theme.muted; vertical-alignment: center; } }
                                    AnswerModeMenu { width: root.mode-column; selection: root.uniform-answer-mode; options: root.answer-mode-labels; bulk: true; label: @tr("统一题型"); choice-available: root.all-choice-available; judgment-available: root.all-judgment-available; enabled: !root.knowledge-only && root.cards.length > 0 && !root.editing && !root.action-pending; choose(index) => { root.set-all-answer-modes(index); } }
                                    Rectangle { width: 32px; }
                                }
                                Rectangle { height: 1px; background: Theme.soft-border; }
                            }
                        }
                        content-area := Rectangle {
                            vertical-stretch: 1;
                            min-height: 0px;
                            background: transparent;
                            border-radius: 0px;
                            question-list := ListView {
                                visible: root.matrix-visible;
                                width: parent.width; height: parent.height;
                                horizontal-scrollbar-policy: always-off;
                                vertical-scrollbar-policy: self.content-height > self.visible-height + 1px ? as-needed : always-off;
                                content-width: self.visible-width;
                                content-y <=> root.question-scroll-y;
                                for card[index] in root.cards : Rectangle {
                                    private property <string> source: card.formula-source;
                                    private property <string> answer-source: card.answer-formula-source;
                                    private property <bool> rendered: card.rendered;
                                    private property <float> scale: root.pixel-scale;
                                    private property <bool> in-view: self.absolute-position.y + self.height > content-area.absolute-position.y && self.absolute-position.y < content-area.absolute-position.y + content-area.height && content-area.height > 0px && question-list.visible;
                                    height: max(52px, question-button.natural-height, quick-answer.preferred-height + 12px);
                                    init => { if self.in-view { root.request-row-formula(index); } }
                                    changed source => { if self.in-view { root.request-row-formula(index); } }
                                    changed answer-source => { if self.in-view { root.request-row-formula(index); } }
                                    changed rendered => { if self.in-view && !self.rendered { root.request-row-formula(index); } }
                                    changed scale => { if self.in-view { root.request-row-formula(index); } }
                                    changed in-view => { if self.in-view { root.request-row-formula(index); } }

                                    HorizontalLayout {
                                        height: parent.height; spacing: 0px;
                                        Rectangle {
                                            width: root.participation-column;
                                            ParticipationCheck { y: (parent.height - self.height) / 2; width: parent.width; checked: card.enabled; label: (card.enabled ? @tr("停止参与：") : @tr("参与练习：")) + card.prompt; enabled: !root.editing && !root.action-pending; toggled(value) => { root.toggle-card(index, value); } }
                                        }
                                        question-button := QuestionButton { height: parent.height; label: card.prompt; preview: card.preview; opacity: card.enabled ? 1 : 0.65; enabled: !root.editing && !root.action-pending; activated => { root.edit-card(index); } }
                                        Rectangle {
                                            width: root.answer-column;
                                            quick-answer := QuickAnswer {
                                                y: (parent.height - self.height) / 2; width: parent.width;
                                                height: self.preferred-height;
                                                identity: card.pack-id + "/" + card.id;
                                                mode: card.answer-mode; value: card.quick-answer; preview: card.answer-preview;
                                                truth: card.truth; options: root.quick-options; label: card.prompt;
                                                enabled: !root.editing && !root.action-pending;
                                                save(input) => { return root.save-quick-answer(card.pack-id, card.id, input); }
                                                prepare-options => { root.prepare-quick-options(card.pack-id, card.id); }
                                                choose(option) => { return root.choose-quick-answer(card.pack-id, card.id, card.answer-mode, option); }
                                            }
                                        }
                                        AnswerModeMenu { y: (parent.height - self.height) / 2; width: root.mode-column; options: root.answer-mode-labels; selection: card.answer-mode; label: @tr("题型") + "：" + card.prompt; choice-available: card.choice-available; judgment-available: card.judgment-available; enabled: !root.knowledge-only && !root.editing && !root.action-pending; choose(mode) => { root.set-card-answer-mode(index, mode); } }
                                        ActionMenu { y: (parent.height - self.height) / 2; label: @tr("题目操作") + "：" + card.prompt; options: [@tr("编辑"), @tr("删除")]; destructive-last: true; enabled: !root.editing && !root.action-pending; choose(action) => { if action == 0 { root.edit-card(index); } else { root.delete-row(index); } } }
                                    }
                                }
                            }
                            if root.current-tab == 0 && !root.editor-visible && !root.has-selection : Text {
                                x: 24px; y: (parent.height - self.height) / 2;
                                width: max(0px, parent.width - 48px);
                                text: @tr("还没有知识包，从左上角新建或导入。");
                                color: Theme.muted; wrap: word-wrap; horizontal-alignment: center;
                            }
                            if root.current-tab == 0 && !root.editor-visible && root.has-selection && root.cards.length == 0 : Text {
                                text: @tr("这个知识包还没有题目，点击上方加号添加。");
                                color: Theme.muted; font-size: 14px; wrap: word-wrap;
                            }
                            if root.current-tab == 0 && root.editor-visible : ScrollView {
                                private property <float> viewport-top: self.absolute-position.y / 1px;
                                changed viewport-top => { root.math-viewport-top = self.viewport-top; }
                                changed height => { root.math-viewport-height = self.height / 1px; }
                                init => { root.math-viewport-top = self.viewport-top; root.math-viewport-height = self.height / 1px; }
                                width: parent.width; height: parent.height;
                                horizontal-scrollbar-policy: always-off;
                                content-width: self.visible-width;
                                content-y <=> root.editor-scroll-y;
                                VerticalLayout {
                                    width: parent.width;
                                    padding-right: 12px;
                                    spacing: 14px;
                                    if root.editor-new-pack : Text { text: @tr("知识包名称"); color: Theme.muted; font-size: 12px; }
                                    if root.editor-new-pack : LineEdit { text <=> root.editor-pack-name; }
                                    Text { text: @tr("题面图片（可选）"); color: Theme.muted; font-size: 12px; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Button { text: root.editor-image-loading ? @tr("正在处理图片…") : root.editor-picture-width > 0 ? @tr("更换图片") : @tr("添加图片"); enabled: !root.editor-image-loading; clicked => { root.choose-question-image(); } }
                                        if root.editor-has-image : DesktopButton { text: @tr("移除图片"); destructive: true; enabled: !root.editor-image-loading; activated => { root.remove-question-image(); } }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                    if root.editor-picture-width > 0 : QuestionPicture {
                                        picture: root.editor-picture; picture-width: root.editor-picture-width; picture-height: root.editor-picture-height;
                                        picture-height-limit: 160px;
                                        vertical-stretch: 0;
                                        changed height => { root.editor-picture-view-height = self.height; }
                                        activated => { root.preview-question-image(); }
                                    }
                                    ContentForm {
                                        functions: root.math-functions;
                                        symbols: root.math-symbols;
                                        fields: root.editor-fields;
                                        answer-mode: root.editor-answer-mode;
                                        correct-choice: root.editor-correct-choice;
                                        truth-choice: root.editor-truth-choice;
                                        choice-changed(index) => { root.editor-correct-choice = index; }
                                        truth-changed(value) => { root.select-truth(value); }
                                        active-field: root.math-active-field;
                                        active-preview: root.math-preview;
                                        regions: root.math-regions;
                                        selection: root.math-selection;
                                        position: root.math-position;
                                        navigation: root.math-navigation;
                                        text-mode: root.math-text-mode;
                                        has-formula: root.math-has-formula;
                                        input <=> root.math-input;
                                        error: root.math-error;
                                        can-undo: root.math-can-undo;
                                        can-redo: root.math-can-redo;
                                        can-move-out: root.math-can-move-out;
                                        can-unwrap: root.math-can-unwrap;
                                        grid-rows: root.math-grid-rows;
                                        grid-columns: root.math-grid-columns;
                                        activate-field(field) => { root.activate-content(field); }
                                        select-region(index) => { root.select-math-region(index); }
                                        edited(input) => { root.edit-math-input(input); }
                                        position-changed(value, anchor, caret) => { root.math-position-changed(value, anchor, caret); }
                                        tool(name) => { root.math-tool(name); }
                                        open-structured-math => { root.open-structured-math(); }
                                        parent => { root.math-parent(); }
                                        undo(redo) => { root.undo-math(redo); }
                                        resize-grid(rows, columns) => { root.resize-math-grid(rows, columns); }
                                        canvas-layout(x,y,scale) => { root.math-canvas-left = x; root.math-canvas-top = y; root.math-canvas-scale = scale; }
                                    }
                                    if root.editor-answer-mode == 0 : Disclosure { label: @tr("其他正确写法"); expanded: root.editor-extra; activated => { root.editor-extra = !root.editor-extra; } }
                                    if root.editor-answer-mode == 0 && root.editor-extra : TextEdit { height: 64px; vertical-stretch: 0; text <=> root.editor-aliases; }
                                }
                            }
                            settings-page := SettingsPage {
                                width: parent.width; height: parent.height;
                                visible: root.current-tab == 1;
                                interval-minutes: root.interval-minutes; interval-options: root.interval-options; interval-selection: root.interval-selection;
                                feedback-seconds: root.feedback-seconds; feedback-options: root.feedback-options; feedback-selection: root.feedback-selection;
                                knowledge-seconds: root.knowledge-seconds; knowledge-options: root.knowledge-options; knowledge-selection: root.knowledge-selection;
                                pause-minutes: root.pause-minutes; pause-options: root.pause-options; pause-selection: root.pause-selection; pause-detail: root.pause-detail;
                                autostart-enabled: root.autostart-enabled; autostart-available: root.autostart-available; autostart-error: root.autostart-error;
                                quiet-hours-enabled: root.quiet-hours-enabled; quiet-start <=> root.quiet-start; quiet-end <=> root.quiet-end; quiet-summary: root.quiet-summary; quiet-time-error: root.quiet-time-error;
                                popup-corner: root.popup-corner; remember-position: root.remember-position;
                                show-pack-tags: root.show-pack-tags;
                                focus-on-reminder: root.focus-on-reminder;
                                auto-check-updates: root.auto-check-updates;
                                interface-language: root.interface-language;
                                appearance: root.appearance;
                                choose-appearance(index) => { root.choose-appearance(index); }
                                choose-language(index) => { root.choose-language(index); }
                                choose-interval(index) => { root.choose-interval(index); }
                                choose-feedback(index) => { root.choose-feedback(index); }
                                choose-knowledge-duration(index) => { root.choose-knowledge-duration(index); }
                                choose-pause(index) => { root.choose-pause(index); }
                                set-interval(value) => { root.set-interval(value); }
                                set-feedback(value) => { root.set-feedback(value); }
                                set-knowledge-duration(value) => { root.set-knowledge-duration(value); }
                                set-pause(value) => { root.set-pause(value); }
                                set-autostart(value) => { root.set-autostart(value); }
                                set-quiet-enabled(value) => { root.set-quiet-enabled(value); }
                                set-quiet-range(start, end) => { root.set-quiet-range(start, end); }
                                set-corner(value) => { root.set-corner(value); }
                                set-remember-position(value) => { root.set-remember-position(value); }
                                set-show-pack-tags(value) => { root.set-show-pack-tags(value); }
                                set-focus-on-reminder(value) => { root.set-focus-on-reminder(value); }
                                set-auto-check-updates(value) => { root.set-auto-check-updates(value); }
                            }
                        }
                    }
                }
            }
            if root.import-pending : Rectangle {
                preferred-height: import-actions.preferred-height;
                background: Theme.caution-soft; border-radius: 6px; border-width: 1px; border-color: Theme.caution-ink;
                import-actions := VerticalLayout {
                    padding: 12px; spacing: 10px;
                    Text { text: root.import-description; wrap: word-wrap; color: Theme.ink; }
                    HorizontalLayout { spacing: 8px; DesktopButton { text: @tr("替换知识包"); primary: true; caution: true; activated => { root.confirm-import(); } } Button { text: @tr("取消"); clicked => { root.cancel-import(); } } Rectangle { horizontal-stretch: 1; background: transparent; } }
                }
            }
            if root.message != "" : Text { text: root.message; color: root.message-is-error ? Theme.wrong-ink : Theme.muted; wrap: word-wrap; font-size: 12px; }
            if root.editor-visible && root.editor-error != "" : Text { text: root.editor-error; color: Theme.wrong-ink; wrap: word-wrap; font-size: 12px; }
            if !root.editor-visible : VerticalLayout {
                vertical-stretch: 0;
                spacing: 10px;
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    height: 36px;
                    spacing: root.editor-visible ? 8px : 12px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    if !root.editor-visible : IconButton { glyph: @image-url("../assets/return_to_tray.svg"); label: @tr("回到托盘"); borderless: true; activated => { root.go-background(); } }
                    if !root.editor-visible : IconButton { glyph: @image-url("../assets/quit.svg"); label: @tr("退出 Try"); ink: Theme.muted; borderless: true; activated => { root.quit-app(); } }
                }
            }
        }
    }
        }
    pack-delete-dialog := DeleteConfirmation {
        width: root.width; height: root.height;
        opened: root.delete-pending; title: @tr("删除知识包"); message: root.delete-description;
        error: root.message-is-error ? root.message : "";
        confirmed => { root.confirm-delete(); }
        cancelled => { root.cancel-delete(); }
    }
    card-delete-dialog := DeleteConfirmation {
        width: root.width; height: root.height;
        opened: root.card-delete-pending; title: @tr("删除题目");
        message: root.card-delete-prompt + "\n\n" + @tr("删除这道题及其练习设置？此操作无法撤销。");
        error: root.message-is-error ? root.message : "";
        confirmed => { root.confirm-card-delete(); }
        cancelled => { root.cancel-card-delete(); }
    }
    // Keep the version metric outside the popup so its controls share testable coordinates.
    version-measure := Text { visible: false; text: root.app-version; font-size: 12px; }
    mit-measure := Text { visible: false; text: @tr("MIT 许可"); font-size: 12px; }
    about-popup := PopupWindow {
        x: root.about-left; y: root.about-top;
        width: 300px; height: root.about-height;
        close-policy: close-on-click-outside;
        forward-focus: about-view;
        about-view := AboutContent {
            width: 100%; height: 100%;
            app-icon: root.app-icon; app-version: root.app-version;
            update-view: { state: root.update-state, status: root.update-status, available: root.update-download, action: root.update-action, busy: root.update-busy, action-kind: root.update-action-kind };
            metrics: { version-width: root.version-width, mit-width: root.mit-width, check-left: root.check-link-left - root.about-left, check-top: root.check-link-top - root.about-top, home-left: root.home-link-left - root.about-left, home-top: root.home-link-top - root.about-top, notices-left: root.notices-link-left - root.about-left, notices-top: root.notices-link-top - root.about-top };
            check-updates => { root.check-updates(); }
            open-update-download => { root.open-update-download(); }
            cancel-update-download => { root.cancel-update-download(); }
            restart-update => { root.restart-update(); }
            open-home => { root.open-project-home(); }
            open-notices => { root.open-notices(); }
            close-view => { root.hide-about(); }
        }
    }
    notices-popup := PopupWindow {
        x: root.about-left; y: root.notices-top; width: 300px; height: 280px;
        close-policy: close-on-click-outside;
        forward-focus: notices-view;
        notices-view := ThirdPartyNotices {
            width: 100%; height: 100%;
            go-back => { root.return-to-about(); root.hide-notices(); }
            close-view => { root.hide-notices(); }
        }
    }
}
