export struct CardRow {
    id: string,
    pack-id: string,
    prompt: string,
    enabled: bool,
    answer-mode: int,
    choice-available: bool,
    judgment-available: bool,
    answer: string,
    answer-formula-source: string,
    answer-preview: AnswerOption,
    quick-answer: string,
    truth: bool,
    formula-source: string,
    rendered: bool,
    formula-scale: float,
    preview: AnswerOption,
}

component EditorModeSwitch inherits KeyboardFocus {
    in property <[string]> labels;
    in property <int> selection;
    callback choose(int);
    private property <length> gap: 4px;
    private property <length> segment-width: (root.width - (root.labels.length - 1) * root.gap) / max(1, root.labels.length);
    private property <float> previous-position;
    private property <int> destination;
    private property <float> indicator-position: root.destination + (root.previous-position - root.destination) * movement.remaining;

    height: 36px; horizontal-stretch: 1;
    focus-on-click: false;
    accessible-role: radio-group;
    accessible-label: @tr("题型");
    accessible-value: root.labels[root.selection];
    accessible-enabled: root.enabled;

    movement := EntranceMotion { duration: 160ms; }
    init => { root.destination = root.selection; }
    changed selection => {
        if root.destination != root.selection {
            root.destination = root.selection;
            movement.play(false);
        }
    }
    function select(index: int, pointer: bool) {
        if !root.enabled || index == root.selection { return; }
        let from = root.indicator-position;
        root.choose(index);
        // The editor can keep its current mode if the active field needs correction.
        if root.selection == index {
            root.previous-position = from;
            root.destination = index;
            movement.play(pointer);
        }
    }
    key-pressed(event) => {
        if event.text == Key.LeftArrow { root.select(max(0, root.selection - 1), false); return accept; }
        if event.text == Key.RightArrow { root.select(min(root.labels.length - 1, root.selection + 1), false); return accept; }
        if event.text == Key.Home { root.select(0, false); return accept; }
        if event.text == Key.End { root.select(root.labels.length - 1, false); return accept; }
        return reject;
    }
    Rectangle {
        x: root.indicator-position * (root.segment-width + root.gap);
        width: root.segment-width; height: root.height;
        border-radius: 5px; background: Theme.primary;
    }
    for label[index] in root.labels : Rectangle {
        private property <bool> selected: index == root.selection;
        private property <bool> filled: abs(root.indicator-position - index) < 0.5;
        x: index * (root.segment-width + root.gap);
        width: root.segment-width; height: root.height;
        border-radius: 5px;
        background: hit.has-hover && root.enabled && !self.selected ? Theme.ink.with-alpha(0.065) : transparent;
        accessible-role: radio-button; accessible-label: label;
        accessible-item-index: index;
        accessible-checkable: true; accessible-checked: self.selected; accessible-enabled: root.enabled;
        accessible-action-default => { root.select(index, false); }
        Text {
            text: label;
            color: !root.enabled ? Theme.disabled : parent.filled ? Theme.primary-ink : Theme.muted;
            horizontal-alignment: center; vertical-alignment: center;
        }
        if self.selected && root.show-focus : FocusOutline { ink: Theme.primary-ink; }
        hit := TouchArea {
            enabled: root.enabled; mouse-cursor: pointer;
            clicked => { root.focus-from-pointer(); root.select(index, true); }
        }
    }
}

component QuestionButton inherits Rectangle {
    in property <string> label;
    in property <AnswerOption> preview;
    in property <bool> enabled: true;
    in property <bool> participating: true;
    out property <bool> pointer-activation;
    callback activated();
    forward-focus: question-focus;
    horizontal-stretch: 1;
    out property <length> natural-height: max(52px, prompt-label.preferred-height + 16px);
    height: root.natural-height;
    background: question-touch.has-hover && root.enabled ? Theme.soft : transparent;
    border-radius: 6px;
    accessible-role: button;
    accessible-label: @tr("编辑题目：") + root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    VerticalLayout {
        padding: 8px; padding-left: 10px; padding-right: 10px; spacing: 6px;
        prompt-label := FormulaLabel {
            fallback: root.label; formula: root.preview.formula;
            formula-width: root.preview.formula-width; formula-height: root.preview.formula-height;
            texts: root.preview.texts; font-size: 14px; align-left: true;
            opacity: root.participating ? 1 : 0.65;
        }
    }
    if question-focus.has-focus : FocusOutline { }
    question-focus := FocusScope {
        enabled: root.enabled;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; }
            return reject;
        }
    }
    question-touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { root.pointer-activation = true; root.activated(); root.pointer-activation = false; }
    }
}

component PracticeModeSwitch inherits KeyboardFocus {
    in property <bool> knowledge-only;
    callback choose(bool);
    Tooltip { text: @markdown("\{@tr("练习方式")}"); }
    private property <length> segment-width: max(74px, max(answer-measure.preferred-width, display-measure.preferred-width) + 22px);
    width: 2 * root.segment-width + 6px; height: 34px;
    focus-on-click: false;
    accessible-role: radio-group;
    accessible-label: @tr("练习方式");
    accessible-value: root.knowledge-only ? @tr("展示") : @tr("答题");
    accessible-enabled: root.enabled;
    key-pressed(event) => {
        if event.text == Key.LeftArrow || event.text == Key.Home { root.choose(false); return accept; }
        if event.text == Key.RightArrow || event.text == Key.End { root.choose(true); return accept; }
        if event.text == Key.Space || event.text == Key.Return { root.choose(!root.knowledge-only); return accept; }
        return reject;
    }
    answer-measure := Text { visible: false; text: @tr("答题"); font-size: 13px; font-weight: 600; }
    display-measure := Text { visible: false; text: @tr("展示"); font-size: 13px; font-weight: 600; }
    Rectangle {
        background: Theme.soft; border-radius: 7px; border-width: 1px; border-color: Theme.soft-border;
        Rectangle {
            x: 3px + (root.knowledge-only ? root.segment-width : 0px); y: 3px;
            width: root.segment-width; height: parent.height - 6px;
            background: Theme.canvas; border-radius: 5px; border-width: 1px; border-color: Theme.control-border;
            animate x { duration: Theme.spatial-motion ? 160ms : 0ms; easing: ease-out; }
        }
        for label[index] in [@tr("答题"), @tr("展示")] : Rectangle {
            private property <bool> selected: root.knowledge-only == (index == 1);
            x: 3px + index * root.segment-width; y: 3px;
            width: root.segment-width; height: parent.height - 6px;
            accessible-role: radio-button; accessible-label: label; accessible-enabled: root.enabled;
            accessible-item-index: index;
            accessible-checkable: true; accessible-checked: self.selected;
            accessible-action-default => { if root.enabled { root.choose(index == 1); } }
            Text {
                text: label; font-size: 13px; font-weight: parent.selected ? 600 : 400;
                color: !root.enabled ? Theme.disabled : parent.selected || hit.has-hover ? Theme.ink : Theme.muted;
                vertical-alignment: center; horizontal-alignment: center;
            }
            if self.selected && root.show-focus : FocusOutline { }
            hit := TouchArea {
                enabled: root.enabled; mouse-cursor: pointer;
                clicked => { root.focus-from-pointer(); root.choose(index == 1); }
            }
        }
    }
}

export component MainWindow inherits DesktopWindow {
    in property <bool> dark-theme: true;
    in property <int> appearance: 2;
    // Use the host's assigned size for breakpoints, outside Slint's preferred-size calculation.
    private property <length> viewport-width: 880px;
    private property <length> viewport-height: 640px;
    private property <length> workspace-margin: root.viewport-width < 780px ? 16px : root.viewport-width < 1060px ? 24px : 32px;
    private property <length> sidebar-width: clamp(root.viewport-width * 0.245, 196px, 232px);
    private property <length> title-size: root.viewport-width < 780px ? 23px : 26px;
    private property <bool> library-visible: root.current-tab == 0 && !root.editor-visible;
    private property <bool> matrix-visible: root.library-visible && root.has-selection && root.cards.length > 0;
    in property <image> app-icon;
    in property <string> app-version;
    in property <int> update-state;
    in property <string> update-status;
    in property <bool> update-download;
    in property <string> update-action;
    in property <bool> update-busy;
    in property <int> update-action-kind;
    out property <length> about-left: 24px;
    out property <length> about-top: root.height - root.about-height - 72px;
    // Reserve the result row so checking cannot resize or move the popup.
    out property <length> about-height: 208px;
    out property <bool> about-open: about-popup.is-open;
    private property <bool> animate-about;
    private property <bool> animate-notices;
    private property <length> version-width: version-measure.preferred-width;
    out property <length> check-link-left: root.about-left + 64px + root.version-width + 4px;
    out property <length> check-link-top: root.about-top + 44px;
    out property <length> home-link-left: root.about-left + 64px;
    out property <length> home-link-top: root.about-top + 116px;
    private property <length> mit-width: mit-measure.preferred-width;
    out property <length> notices-link-left: root.home-link-left + root.mit-width + 18px;
    out property <length> notices-link-top: root.home-link-top + 36px;
    out property <length> notices-top: root.height - 280px - 72px;
    callback check-updates();
    callback update-check-finished();
    callback open-update-download();
    callback cancel-update-download();
    callback restart-update();
    callback update-editing-changed();
    callback open-project-home();
    callback open-notices(bool);
    callback return-to-about(bool);
    icon: root.app-icon;
    title: "Try";
    sidebar-extent: root.sidebar-width;
    controls-in-footer: true;
    controls-right-inset: root.workspace-margin;
    private property <length> footer-bottom-padding: 12px;
    private property <length> footer-height: 36px;
    controls-bottom-inset: root.footer-bottom-padding + (root.footer-height - root.titlebar-height) / 2;
    footer-actions-enabled: !root.pack-transfer-busy;
    out property <WindowControlBounds> window-controls: root.control-bounds;
    leading-action: { glyph: @image-url("../assets/return_to_tray.svg"), label: @tr("回到托盘") };
    trailing-action: { glyph: @image-url("../assets/quit.svg"), label: @tr("退出 Try") };
    leading-activated(pointer) => {
        root.leave-from-pointer = pointer; root.go-background(); root.leave-from-pointer = false;
    }
    trailing-activated(pointer) => {
        root.leave-from-pointer = pointer; root.quit-app(); root.leave-from-pointer = false;
    }
    preferred-width: 880px;
    preferred-height: 640px + root.titlebar-height;
    min-width: 720px;
    min-height: 480px + root.titlebar-height;
    background: Theme.canvas;
    default-font-size: 13px;
    init => { Theme.dark = root.dark-theme; Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    changed dark-theme => { Theme.dark = root.dark-theme; Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    changed width => { root.viewport-width = self.width; root.reposition-info-popup(); }
    changed height => { root.viewport-height = self.height - root.titlebar-height; root.reposition-info-popup(); }

    in property <[PackRow]> packs;
    in property <string> participation-summary;
    in property <int> selected-index: 0;
    in property <string> selected-name;
    in property <bool> selected-enabled;
    in property <bool> selection-partial;
    in property <string> selected-card-count;
    in property <[CardRow]> cards;
    in-out property <length> question-scroll-y: 0px;
    in-out property <length> editor-scroll-y: 0px;
    in property <[string]> answer-mode-labels: [@tr("填空"), @tr("选择"), @tr("判断")];
    in property <int> uniform-answer-mode: -1;
    in property <bool> all-choice-available;
    in property <bool> all-judgment-available;
    in property <bool> knowledge-only;
    in property <string> selected-description;
    in property <string> selected-description-summary;
    in property <string> selected-tag;
    in-out property <bool> description-expanded;
    private property <bool> animate-description;
    private property <float> description-reveal: root.description-expanded && !root.description-editing ? 1 : 0;
    private property <float> description-progress: Theme.spatial-motion ? root.description-reveal
        : root.description-expanded && !root.description-editing ? 1 : 0;
    animate description-reveal {
        duration: root.animate-description && Theme.spatial-motion ? 165ms : 0ms;
        easing: cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    in-out property <bool> name-editing;
    in-out property <bool> description-editing;
    in-out property <bool> tag-editing;
    private property <bool> update-editing: root.editor-visible || root.import-pending || root.leave-pending || root.pack-transfer-busy
        || root.name-editing || root.description-editing || root.tag-editing || MathInputState.open;
    changed update-editing => { root.update-editing-changed(); }
    in-out property <string> name-draft;
    in-out property <string> description-draft;
    in-out property <string> tag-draft;
    in-out property <string> metadata-error;
    private property <bool> editing: root.editor-visible || root.name-editing || root.description-editing || root.tag-editing;
    private property <bool> action-pending: root.import-pending || root.delete-pending || root.card-delete-pending
        || root.leave-pending || root.pack-transfer-busy;
    out property <bool> tray-settings-available: !root.editing && !root.action-pending;
    changed tray-settings-available => { root.tray-navigation-changed(); }
    private property <length> participation-column: 36px;
    private property <length> mode-column: 88px;
    private property <length> answer-column: clamp(question-list.visible-width * 0.26, 100px, 228px);
    in property <[AnswerOption]> quick-options;
    in property <bool> has-selection;
    in property <int> interval-minutes: 30;
    in property <[string]> interval-options;
    in property <int> interval-selection;
    in property <int> feedback-seconds: 8;
    in property <[string]> feedback-options;
    in property <int> feedback-selection;
    in property <int> knowledge-seconds: 8;
    in property <[string]> knowledge-options;
    in property <int> knowledge-selection;
    in property <int> pause-minutes;
    in property <[string]> pause-options;
    in property <int> pause-selection;
    in property <string> pause-detail;
    in property <bool> autostart-enabled;
    in property <bool> autostart-available: true;
    in property <string> autostart-error;
    in property <bool> quiet-hours-enabled;
    in-out property <string> quiet-start: "22:00";
    in-out property <string> quiet-end: "08:00";
    in property <string> quiet-summary;
    in property <string> quiet-time-error;
    in property <bool> quiet-time-dirty;
    in property <int> popup-corner: 0;
    in property <bool> card-resize-available;
    in property <bool> card-locked;
    in property <bool> has-custom-card-size;
    in property <bool> show-pack-tags: true;
    in property <bool> show-practice-hints: true;
    in property <bool> interface-animations: true;
    in property <bool> focus-on-reminder: true;
    in property <bool> auto-check-updates: true;
    in property <bool> has-custom-position;
    in property <int> interface-language;
    in property <string> message;
    in property <bool> message-is-error;
    in property <bool> import-pending;
    out property <bool> import-from-pointer;
    in property <bool> animate-import-confirmation;
    private property <bool> animate-delete-confirmation;
    in property <bool> pack-transfer-busy;
    in property <bool> pack-transfer-failed;
    in property <string> pack-transfer-message;
    in property <bool> leave-pending;
    in property <string> leave-description;
    in property <bool> animate-leave-confirmation;
    out property <bool> leave-from-pointer;
    private property <int> draft-focus-request;
    in property <string> import-description;
    in property <bool> delete-pending;
    in property <string> delete-description;
    in-out property <int> current-tab: 0;
    in property <bool> editor-visible;
    private property <length> editor-action-width: max(64px, editor-cancel.preferred-width, editor-save.preferred-width);
    changed editor-visible => { if !root.editor-visible { editor-entrance.play(false); } }
    in property <bool> editor-new-pack;
    in property <bool> editor-can-delete;
    in property <bool> card-delete-pending;
    in property <string> card-delete-prompt;
    in property <string> editor-title;
    in-out property <int> editor-answer-mode;
    in-out property <int> editor-correct-choice;
    in-out property <int> editor-truth-choice: -1;
    in property <string> editor-error;
    in property <string> editor-preview-error;
    in property <AnswerOption> editor-prompt-preview;
    in property <AnswerOption> editor-answer-preview;
    in property <[AnswerOption]> editor-fields;
    in-out property <float> math-viewport-top;
    in-out property <float> math-viewport-height;
    in property <int> math-active-field: -1;
    in property <AnswerOption> math-preview;
    in property <[MathRegion]> math-regions;
    in property <MathRegion> math-selection;
    in property <FormulaPosition> math-position;
    in property <FormulaNavigation> math-navigation;
    in property <bool> math-text-mode;
    in property <bool> math-field-formula;
    in property <bool> math-has-formula;
    in property <[MathTool]> math-functions;
    in property <[MathTool]> math-symbols;
    in-out property <string> math-input;
    in property <string> math-error;
    in property <bool> math-can-undo;
    in property <bool> math-can-redo;
    in property <bool> math-can-move-out;
    in property <bool> math-can-unwrap;
    in property <int> math-grid-rows;
    in property <int> math-grid-columns;
    in-out property <float> math-canvas-left;
    in-out property <float> math-canvas-top;
    in-out property <float> math-canvas-scale: 1;
    in-out property <string> editor-pack-name;
    in-out property <string> editor-prompt;
    in-out property <string> editor-answer;
    in-out property <string> editor-aliases;
    in property <image> editor-picture;
    in property <float> editor-picture-width;
    in property <float> editor-picture-height;
    in property <bool> editor-image-loading;
    out property <length> editor-picture-view-height;
    in property <bool> editor-has-image;
    in-out property <string> editor-prompt-latex;
